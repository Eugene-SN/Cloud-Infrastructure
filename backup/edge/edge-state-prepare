#!/bin/bash
set -Eeuo pipefail

STAGING_ROOT='/var/lib/backrest-staging/edge-state'

RUN_ID="$(date '+%Y%m%dT%H%M%S').$$"

NEXT="$STAGING_ROOT/next.$RUN_ID"
CURRENT="$STAGING_ROOT/current"
PREVIOUS="$STAGING_ROOT/previous"

# Backups may read running services, but must never control their lifecycle.
COMMITTED=0

mkdir -p "$STAGING_ROOT"

exec 9>/run/lock/edge-state-prepare.lock
flock -w 600 9

cleanup_staging() {
  rc=$?
  if [ "$COMMITTED" -eq 0 ]; then
    rm -rf "$NEXT"
  fi
  return "$rc"
}
trap cleanup_staging EXIT

# Files may disappear while an application writes. Only rsync's specific
# vanished-source result is acceptable; permission/I/O/copy errors still fail.
online_rsync() {
  local rc
  if rsync "$@"; then
    return 0
  else
    rc=$?
    if [ "$rc" -eq 24 ]; then
      printf 'ONLINE_FILES_WARNING=vanished_source|consistency=best_effort\n' >&2
      return 0
    fi
    return "$rc"
  fi
}

prepare_weblate() {
  local stage="$1/weblate"
  mkdir -p "$stage/postgres" "$stage/data" "$stage/config"
  docker exec postgres pg_dump -U postgres -d weblate -Fc >"$stage/postgres/weblate.dump"
  test -s "$stage/postgres/weblate.dump"
  docker exec -i postgres pg_restore -l <"$stage/postgres/weblate.dump" >/dev/null
  chmod 0600 "$stage/postgres/weblate.dump"
  online_rsync -a /srv/weblate/data/ "$stage/data/"
  online_rsync -a /opt/weblate/ "$stage/config/"
  cat >"$stage/MANIFEST.txt" <<EOF
schema=weblate-online-backup-v2
created_at=$(date --iso-8601=seconds)
database=weblate
role=weblate
data_dir=/srv/weblate/data
configuration=/opt/weblate
database_consistency=pg_dump_snapshot
files_consistency=live_best_effort_not_atomic_with_database
service_lifecycle=untouched
cache=valkey_reconstructed_not_historical_queue_state
EOF
  chmod 0600 "$stage/MANIFEST.txt"
  printf 'WEBLATE_STAGE_GATE=PASS\n'
}


rm -rf "$NEXT"
mkdir -p "$NEXT"

printf 'PREPARE_RUN_ID=%s\n' "$RUN_ID"

printf '\n--- n8n ---\n'

mkdir -p "$NEXT/n8n"

online_rsync -a \
  --exclude='database.sqlite' \
  --exclude='database.sqlite-wal' \
  --exclude='database.sqlite-shm' \
  /srv/n8n/ \
  "$NEXT/n8n/"

python3 - \
  /srv/n8n/database.sqlite \
  "$NEXT/n8n/database.sqlite" <<'PY'
import os
import sqlite3
import stat
import sys

src, dst = sys.argv[1:3]

source = sqlite3.connect(
    f"file:{src}?mode=ro",
    uri=True,
    timeout=60,
)

target = sqlite3.connect(dst)

with target:
    source.backup(target, pages=256, sleep=0.05)

target.execute("PRAGMA journal_mode=DELETE")

result = target.execute(
    "PRAGMA integrity_check"
).fetchone()[0]

source.close()
target.close()

if result != "ok":
    raise SystemExit(
        f"N8N_SQLITE_INTEGRITY_FAIL={result}"
    )

st = os.stat(src)
os.chown(dst, st.st_uid, st.st_gid)
os.chmod(dst, stat.S_IMODE(st.st_mode))

print("N8N_STAGE_GATE=PASS")
PY

printf '\n--- Authelia ---\n'

mkdir -p "$NEXT/authelia"

online_rsync -a \
  --exclude='data/db.sqlite3' \
  --exclude='data/db.sqlite3-wal' \
  --exclude='data/db.sqlite3-shm' \
  /srv/authelia/ \
  "$NEXT/authelia/"

mkdir -p "$NEXT/authelia/data"

python3 - \
  /srv/authelia/data/db.sqlite3 \
  "$NEXT/authelia/data/db.sqlite3" <<'PY'
import os
import sqlite3
import stat
import sys

src, dst = sys.argv[1:3]

source = sqlite3.connect(
    f"file:{src}?mode=ro",
    uri=True,
    timeout=60,
)

target = sqlite3.connect(dst)

with target:
    source.backup(target, pages=256, sleep=0.05)

target.execute("PRAGMA journal_mode=DELETE")

result = target.execute(
    "PRAGMA integrity_check"
).fetchone()[0]

source.close()
target.close()

if result != "ok":
    raise SystemExit(
        f"AUTHELIA_SQLITE_INTEGRITY_FAIL={result}"
    )

st = os.stat(src)
os.chown(dst, st.st_uid, st.st_gid)
os.chmod(dst, stat.S_IMODE(st.st_mode))

print("AUTHELIA_STAGE_GATE=PASS")
PY

printf '\n--- Consolidated PostgreSQL globals ---\n'

mkdir -p "$NEXT/postgres"

docker exec postgres \
  pg_dumpall \
  -U postgres \
  --globals-only \
  >"$NEXT/postgres/globals.sql"

if [ ! -s "$NEXT/postgres/globals.sql" ]; then
  printf 'POSTGRES_GLOBALS_EMPTY\n' >&2
  exit 1
fi

chmod 0600 "$NEXT/postgres/globals.sql"

printf 'POSTGRES_GLOBALS_STAGE_GATE=PASS\n'

printf '\n--- Mattermost online dump and live files ---\n'

mkdir -p \
  "$NEXT/mattermost/app" \
  "$NEXT/mattermost/postgres"

docker exec postgres \
  pg_dump \
  -U postgres \
  -d mattermost \
  -Fc \
  >"$NEXT/mattermost/postgres/mattermost.dump"

if [ ! -s "$NEXT/mattermost/postgres/mattermost.dump" ]; then
  printf 'MATTERMOST_DUMP_EMPTY\n' >&2
  exit 1
fi

docker exec -i postgres \
  pg_restore -l \
  <"$NEXT/mattermost/postgres/mattermost.dump" \
  >/dev/null

online_rsync -a \
  /srv/mattermost/volumes/app/mattermost/ \
  "$NEXT/mattermost/app/"

printf 'MATTERMOST_STAGE_GATE=PASS\n'

printf '\n--- Mail configuration and Bulwark files ---\n'

mkdir -p "$NEXT/mail"
# Stalwart uses a live RocksDB store. Plain file copies of it are not an
# online database backup; omit the store instead of stopping mail delivery.
online_rsync -a --exclude='/stalwart/lib/' /srv/mail/ "$NEXT/mail/"
cat >"$NEXT/mail/MANIFEST.txt" <<EOF
schema=mail-online-files-v2
created_at=$(date --iso-8601=seconds)
included=stalwart_configuration_tls_and_bulwark_files
excluded=/srv/mail/stalwart/lib
reason=live_rocksdb_requires_separately_validated_online_backup
files_consistency=live_best_effort_not_atomic
service_lifecycle=untouched
EOF
chmod 0600 "$NEXT/mail/MANIFEST.txt"
printf 'MAIL_CONFIG_STAGE_GATE=PASS|MAIL_STORE=EXCLUDED\n'

printf '\n--- Agent SQLite overlay ---\n'

python3 - "$NEXT/sqlite-overlay" <<'PY'
import os
import pathlib
import sqlite3
import stat
import sys

dest_root = pathlib.Path(sys.argv[1])

roots = [
    pathlib.Path("/home/core/.hermes"),
    pathlib.Path("/home/core/.codex"),
    pathlib.Path("/home/core/.gemini"),
]

candidates = []

for root in roots:
    if not root.exists():
        continue

    for path in root.rglob("*"):
        if not path.is_file():
            continue

        if path.name.endswith(("-wal", "-shm")):
            continue

        if path.suffix.lower() in {
            ".db",
            ".sqlite",
            ".sqlite3",
        }:
            candidates.append(path)

count = 0

for src in sorted(candidates):
    rel = pathlib.Path(str(src).lstrip("/"))
    dst = dest_root / rel

    dst.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    source = sqlite3.connect(
        f"file:{src}?mode=ro",
        uri=True,
        timeout=60,
    )

    target = sqlite3.connect(dst)

    with target:
        source.backup(target, pages=256, sleep=0.05)

    target.execute("PRAGMA journal_mode=DELETE")

    result = target.execute(
        "PRAGMA integrity_check"
    ).fetchone()[0]

    source.close()
    target.close()

    if result != "ok":
        raise RuntimeError(
            f"{src}: integrity={result}"
        )

    st = os.stat(src)

    os.chown(
        dst,
        st.st_uid,
        st.st_gid,
    )

    os.chmod(
        dst,
        stat.S_IMODE(st.st_mode),
    )

    print(
        f"SQLITE_STAGE"
        f"|source={src}"
        f"|target={dst}"
        f"|integrity=ok"
    )

    count += 1

print(f"AGENT_SQLITE_STAGE_COUNT={count}")

if count == 0:
    raise SystemExit(
        "AGENT_SQLITE_STAGE_GATE=FAIL"
    )

print("AGENT_SQLITE_STAGE_GATE=PASS")
PY

printf '\n--- Nextcloud database dump ---\n'

mkdir -p "$NEXT/nextcloud/postgres"

docker exec postgres \
  pg_dump \
  -U postgres \
  -d nextcloud \
  -Fc \
  >"$NEXT/nextcloud/postgres/nextcloud.dump"

if [ ! -s "$NEXT/nextcloud/postgres/nextcloud.dump" ]; then
  printf 'NEXTCLOUD_DUMP_EMPTY\n' >&2
  exit 1
fi

docker exec -i postgres \
  pg_restore -l \
  <"$NEXT/nextcloud/postgres/nextcloud.dump" \
  >/dev/null

printf 'NEXTCLOUD_STAGE_GATE=PASS\n'

printf '\n--- Plane online dump and live uploads ---\n'

mkdir -p "$NEXT/plane/postgres" "$NEXT/plane/uploads" "$NEXT/plane/runtime"
docker exec postgres pg_dump -U postgres -d plane -Fc >"$NEXT/plane/postgres/plane.dump"
test -s "$NEXT/plane/postgres/plane.dump"
docker exec -i postgres pg_restore -l <"$NEXT/plane/postgres/plane.dump" >/dev/null

PLANE_UPLOADS="$(docker volume inspect plane_uploads --format '{{.Mountpoint}}')"
test "$PLANE_UPLOADS" = '/var/lib/docker/volumes/plane_uploads/_data'
online_rsync -a "$PLANE_UPLOADS/" "$NEXT/plane/uploads/"
online_rsync -a /opt/plane/ "$NEXT/plane/runtime/"
cp /usr/local/sbin/plane-compose "$NEXT/plane/runtime/plane-compose"
cp /etc/nginx/sites-available/projects-escloud-us.conf "$NEXT/plane/runtime/projects-escloud-us.conf"
python3 - "$NEXT/plane/runtime/images.json" <<'PY'
import json
import pathlib
import subprocess
import sys

ids = subprocess.check_output(
    ['docker', 'ps', '-a', '-q', '--filter', 'label=com.docker.compose.project=plane'], text=True,
).split()
containers = json.loads(subprocess.check_output(['docker', 'inspect', *ids], text=True))
expected = {'web', 'api', 'admin', 'space', 'live', 'worker', 'beat-worker', 'plane-redis', 'plane-mq', 'plane-minio'}
assert {c['Config']['Labels']['com.docker.compose.service'] for c in containers} == expected
images = json.loads(subprocess.check_output(
    ['docker', 'image', 'inspect', *sorted({c['Image'] for c in containers})], text=True,
))
image_index = {i['Id']: i for i in images}
manifest = {c['Config']['Labels']['com.docker.compose.service']: {
    'reference': c['Config']['Image'], 'image_id': c['Image'],
    'repo_digests': image_index[c['Image']]['RepoDigests'],
} for c in containers}
assert all(item['repo_digests'] for item in manifest.values())
path = pathlib.Path(sys.argv[1])
path.write_text(json.dumps(manifest, indent=2) + '\n')
path.chmod(0o600)
print('PLANE_RECOVERY_IMAGE_IDENTITIES=PASS')
PY
chmod 0600 "$NEXT/plane/postgres/plane.dump"

printf 'PLANE_STAGE_GATE=PASS\n'

if [ -f /opt/weblate/compose.yaml ]; then
  prepare_weblate "$NEXT"
fi

printf '\n--- Manifest ---\n'

cat >"$NEXT/MANIFEST.txt" <<EOF
schema=edge-state-online-staging-v2
created_at=$(date --iso-8601=seconds)
hostname=$(hostname -s)
n8n=consistent_sqlite_plus_files
authelia=consistent_sqlite_plus_files
postgres_globals=pg_dumpall_globals_only
mattermost=online_pg_dump_plus_live_best_effort_app_files
mail=configuration_tls_bulwark_files_only
mail_store=excluded_live_rocksdb
agent_sqlite=consistent_overlay
nextcloud=consolidated_postgres_pg_dump_consistent
plane=online_pg_dump_plus_live_best_effort_uploads_and_runtime
plane_valkey=cache_pubsub_reconstructed_not_historical_state
weblate=online_pg_dump_plus_live_best_effort_data_and_configuration
plane_rabbitmq=task_queue_reconstructed_not_historical_state
service_lifecycle=untouched_no_stop_start_restart_pause_kill_or_maintenance
files_consistency=live_best_effort_not_atomic_with_database
postgres_physical_data=excluded_use_logical_dumps
inflight_tasks=not_captured
EOF

chmod 0600 "$NEXT/MANIFEST.txt"

printf '\n--- Commit staging generation ---\n'

rm -rf "$PREVIOUS"

if [ -e "$CURRENT" ]; then
  mv "$CURRENT" "$PREVIOUS"
fi

if mv "$NEXT" "$CURRENT"; then
  COMMITTED=1
else
  rc=$?

  if [ -e "$PREVIOUS" ] &&
     [ ! -e "$CURRENT" ]
  then
    mv "$PREVIOUS" "$CURRENT"
  fi

  exit "$rc"
fi

rm -rf "$PREVIOUS"

printf 'STAGING_COMMIT_GATE=PASS\n'
printf 'STAGING_CURRENT=%s\n' "$CURRENT"

trap - EXIT
exit 0
