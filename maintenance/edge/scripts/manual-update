#!/usr/bin/env python3
"""Execute manual updates strictly from the Edge maintenance allowlist."""

import argparse
import datetime as dt
import json
import os
import pathlib
import runpy
import shutil
import subprocess
import sys

BASE = pathlib.Path("/opt/edge-maintenance")
MANIFEST = BASE / "config/update-units.json"
ENABLEMENT = pathlib.Path("/etc/edge-maintenance/manual-driver-enablement.json")
STATUS_CACHE = pathlib.Path("/var/www/maintenance-status/maintenance.json")
CORE_UID = 1000


def run(argv, **kwargs):
    print("RUN=" + " ".join(argv), flush=True)
    return subprocess.run(argv, check=True, **kwargs)


def run_as_core(argv):
    print("RUN_CORE=" + " ".join(argv), flush=True)
    return subprocess.run(
        [
            "runuser",
            "-u",
            "core",
            "--",
            "env",
            f"XDG_RUNTIME_DIR=/run/user/{CORE_UID}",
            *argv,
        ],
        check=True,
    )


def verify_core_context():
    runtime_dir = pathlib.Path(f"/run/user/{CORE_UID}")
    if not runtime_dir.is_dir():
        raise RuntimeError(
            f"core user runtime directory missing: {runtime_dir}"
        )
    bus = runtime_dir / "bus"
    if not bus.exists():
        raise RuntimeError(f"core user systemd bus missing: {bus}")


def verify_hermes_lazy_dependencies():
    for tool in ("rg", "fd"):
        path = shutil.which(tool)
        if not path:
            raise RuntimeError(f"missing lazy Hermes dependency: {tool}")
        run([path, "--version"])


def units():
    data = json.loads(MANIFEST.read_text(encoding="utf-8"))
    return data, {u["id"]: u for u in data["units"]}


def require_enablement(target):
    if not ENABLEMENT.is_file():
        raise RuntimeError("driver enablement file missing")
    enablement = json.loads(ENABLEMENT.read_text(encoding="utf-8"))
    if enablement.get("schema") != 2:
        raise RuntimeError("unsupported enablement schema")
    if not enablement.get("enabled", {}).get(target):
        raise RuntimeError(f"target is disabled in configuration: {target}")


def require_fresh_update(target, max_age_seconds):
    if not STATUS_CACHE.is_file():
        raise RuntimeError("maintenance cache missing")
    cache = json.loads(STATUS_CACHE.read_text(encoding="utf-8"))
    if (
        cache.get("schema") != 3
        or cache.get("target_model") != "update_units_v5"
    ):
        raise RuntimeError("unsupported maintenance cache contract")
    stamp = dt.datetime.fromisoformat(
        cache["generated_at"].replace("Z", "+00:00")
    )
    age = (dt.datetime.now(dt.timezone.utc) - stamp).total_seconds()
    if age < 0 or age > max_age_seconds:
        raise RuntimeError(f"maintenance cache is stale: {int(age)}s")
    for row in cache.get("rows", []):
        if row.get("component") == target:
            if row.get("actionable") is not True:
                raise RuntimeError(
                    f"target is not marked actionable in cache: {target}"
                )
            if row.get("status") != "UPDATE_AVAILABLE":
                raise RuntimeError(
                    f"no update is currently available in cache: {target}"
                )
            return row
    raise RuntimeError(f"target missing from maintenance cache: {target}")


def require_master_update(target, batch_generated_at):
    if not STATUS_CACHE.is_file():
        raise RuntimeError("maintenance cache missing")
    cache = json.loads(STATUS_CACHE.read_text(encoding="utf-8"))
    if (
        cache.get("schema") != 3
        or cache.get("target_model") != "update_units_v5"
    ):
        raise RuntimeError("unsupported maintenance cache contract")
    if cache.get("generated_at") != batch_generated_at:
        raise RuntimeError("maintenance cache changed during Master Batch")
    for row in cache.get("rows", []):
        if row.get("component") == target:
            if row.get("actionable") is not True:
                raise RuntimeError(
                    f"target is not marked actionable in cache: {target}"
                )
            if row.get("status") != "UPDATE_AVAILABLE":
                raise RuntimeError(
                    f"no update is currently available in cache: {target}"
                )
            return row
    raise RuntimeError(f"target missing from maintenance cache: {target}")


def normalized_image_reference(reference):
    for prefix in ("docker.io/", "index.docker.io/"):
        if reference.startswith(prefix):
            return reference[len(prefix):]
    return reference


def preflight(unit):
    driver = unit["driver"]
    if driver in ("compose", "nextcloud_compose", "stalwart_compose", "openproject_compose"):
        directory = pathlib.Path(unit["directory"])
        for item in unit["files"]:
            if not (directory / item).is_file():
                raise RuntimeError(f"missing compose file: {directory / item}")
        run(["docker", "compose", *sum((["-f", f] for f in unit["files"]), []), "config", "--quiet"], cwd=directory)
        if driver == "nextcloud_compose":
            helper = pathlib.Path("/opt/edge-maintenance/scripts/update-nextcloud")
            if not helper.is_file():
                raise RuntimeError(f"missing Nextcloud update helper: {helper}")
        elif driver == "stalwart_compose":
            helper = pathlib.Path("/opt/edge-maintenance/scripts/update-stalwart")
            if not helper.is_file():
                raise RuntimeError(f"missing Stalwart update helper: {helper}")
            run([sys.executable, str(helper), "--preflight"])
        elif driver == "openproject_compose":
            helper = pathlib.Path("/opt/edge-maintenance/scripts/update-openproject")
            if not helper.is_file():
                raise RuntimeError(f"missing OpenProject update helper: {helper}")
            run([sys.executable, str(helper), "--preflight"])
    elif driver == "user_cli":
        if not pathlib.Path(unit["binary"]).is_file():
            raise RuntimeError(f"missing CLI: {unit['binary']}")
        verify_core_context()
        run_as_core([unit["binary"], "--version"])
    elif driver == "self_update":
        if not pathlib.Path(unit["binary"]).is_file():
            raise RuntimeError(f"missing binary: {unit['binary']}")
        verify_core_context()
        run([unit["binary"], "version"])
    elif driver == "maintctl" and not pathlib.Path("/usr/local/bin/maintctl").is_file():
        raise RuntimeError("missing maintctl")
    elif driver == "github_binary" and not pathlib.Path(f"/usr/local/bin/{unit['id'].lower()}").is_file():
        raise RuntimeError("missing installed binary")
    elif driver == "apt" and not shutil.which("apt-get"):
        raise RuntimeError("missing apt-get")
    print(f"DRIVER_PREFLIGHT={unit['id']}:PASS")


def execute(unit, status_row):
    driver = unit["driver"]
    if driver == "apt":
        env = {
            **os.environ,
            "DEBIAN_FRONTEND": "noninteractive",
            "NEEDRESTART_MODE": "a",
        }
        run(["apt-get", "update"], env=env)
        run(
            [
                "apt-get",
                "-o",
                "Dpkg::Options::=--force-confdef",
                "-o",
                "Dpkg::Options::=--force-confold",
                "dist-upgrade",
                "-y",
            ],
            env=env,
        )
        run(["apt-get", "autoremove", "-y"], env=env)
        run(["apt-get", "clean"], env=env)
    elif driver == "maintctl":
        run(["/usr/local/bin/maintctl", "update", unit["argument"]])
    elif driver == "github_binary":
        binary_name = unit["id"].lower()
        target = pathlib.Path(f"/usr/local/bin/{binary_name}")
        old_bin = pathlib.Path(f"/usr/local/bin/{binary_name}.old")
        tmp_bin = pathlib.Path(f"/usr/local/bin/{binary_name}.new")
        service = unit["service"]

        try:
            old_bin.unlink(missing_ok=True)
            tmp_bin.unlink(missing_ok=True)
            installed = (
                subprocess.run(
                    [str(target), "--version"],
                    capture_output=True,
                    text=True,
                    check=True,
                )
                .stdout.splitlines()[0]
                .strip()
            )
            download = BASE / "scripts/download-github-release-binary"
            run(
                [
                    str(download),
                    unit["repository"],
                    binary_name,
                    str(tmp_bin),
                ]
            )
            run(["systemctl", "stop", service])
            if target.exists():
                target.rename(old_bin)
            shutil.move(str(tmp_bin), str(target))
            target.chmod(0o755)
            run(["systemctl", "start", service])
            run(["systemctl", "is-active", "--quiet", service])
            old_bin.unlink(missing_ok=True)
        except Exception:
            if old_bin.exists() and not target.exists():
                old_bin.rename(target)
            tmp_bin.unlink(missing_ok=True)
            subprocess.run(
                ["systemctl", "restart", service],
                check=False,
            )
            raise
    elif driver == "nextcloud_compose":
        run([
            sys.executable,
            "/opt/edge-maintenance/scripts/update-nextcloud",
        ])
    elif driver == "stalwart_compose":
        target = str(status_row.get("available_application_version") or "")
        track = str(status_row.get("image_track") or "")
        digest = str(status_row.get("remote_image_digest") or "")
        if not target or not track or not digest.startswith("sha256:"):
            raise RuntimeError("fresh Stalwart target identity is incomplete")
        run([
            sys.executable,
            "/opt/edge-maintenance/scripts/update-stalwart",
            "--target-version",
            target,
            "--target-track",
            track,
            "--target-digest",
            digest,
        ])
    elif driver == "openproject_compose":
        helper = pathlib.Path("/opt/edge-maintenance/scripts/update-openproject")
        if not helper.is_file():
            raise RuntimeError(f"missing OpenProject update helper: {helper}")
        run([
            sys.executable,
            str(helper),
        ])
    elif driver == "compose":
        directory = pathlib.Path(unit["directory"])
        compose = ["docker", "compose", *sum((["-f", f] for f in unit["files"]), [])]
        services = unit.get("services", [unit["service"]])
        primary_service = unit["service"]
        repository = str(status_row.get("image_repository") or "")
        track = str(status_row.get("image_track") or "")
        digest = str(status_row.get("remote_image_digest") or "")
        if not repository or not track or not digest.startswith("sha256:"):
            raise RuntimeError("fresh registry image identity is incomplete")
        image = f"{repository}:{track}"
        pinned = f"{repository}@{digest}"
        config = subprocess.run(
            compose + ["config", "--format", "json"],
            cwd=directory,
            check=True,
            capture_output=True,
            text=True,
        )
        config_data = json.loads(config.stdout)
        configured_services = config_data.get("services", {})
        for service in services:
            configured = configured_services.get(service, {}).get("image")
            if normalized_image_reference(configured) != normalized_image_reference(image):
                raise RuntimeError(
                    f"compose image mismatch: service={service} expected={image} "
                    f"configured={configured or 'absent'}"
                )

        old_image_ids = set()
        for service in services:
            proc = subprocess.run(
                compose + ["images", "-q", service],
                cwd=directory,
                capture_output=True,
                text=True,
            )
            for line in proc.stdout.splitlines():
                img_id = line.strip()
                if img_id:
                    old_image_ids.add(img_id)

        run(["docker", "pull", pinned])
        run(["docker", "tag", pinned, image])
        run(
            compose + ["up", "-d", "--wait", "--force-recreate", *services],
            cwd=directory,
        )

        new_image_ids = set()
        for service in services:
            proc = subprocess.run(
                compose + ["images", "-q", service],
                cwd=directory,
                capture_output=True,
                text=True,
            )
            for line in proc.stdout.splitlines():
                img_id = line.strip()
                if img_id:
                    new_image_ids.add(img_id)

        for old_id in old_image_ids:
            if old_id not in new_image_ids:
                subprocess.run(["docker", "rmi", old_id], capture_output=True, check=False)

        subprocess.run(["docker", "image", "prune", "-f"], capture_output=True, check=False)
    elif driver == "self_update":
        run([unit["binary"], *unit.get("arguments", [])])
        for service in unit.get("user_services", []):
            run_as_core(["systemctl", "--user", "restart", service])
        old_bin = pathlib.Path(f"{unit['binary']}.old")
        if old_bin.is_file():
            try:
                old_bin.unlink()
            except OSError:
                pass

    elif driver == "user_cli":
        run_as_core([unit["binary"], *unit["arguments"]])
        for service in unit.get("services", []):
            run_as_core(["systemctl", "--user", "restart", service])
        if unit.get("system_service"):
            run(["systemctl", "restart", unit["system_service"]])
        if unit["id"] == "HERMES":
            verify_hermes_lazy_dependencies()
    else:
        raise RuntimeError(f"unsupported driver: {driver}")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("target")
    parser.add_argument("--preflight", action="store_true")
    parser.add_argument("--master-batch-generated-at")
    args = parser.parse_args()
    manifest, index = units()
    if args.target not in index:
        raise RuntimeError("target is not in the fixed allowlist")
    unit = index[args.target]
    preflight(unit)
    if args.preflight:
        print("REAL_UPDATE_EXECUTED=NO")
        return
    require_enablement(args.target)
    if args.master_batch_generated_at:
        if unit.get("master_policy") == "individual_only":
            raise RuntimeError(f"Master target requires individual update: {args.target}")
        status_row = require_master_update(args.target, args.master_batch_generated_at)
    else:
        status_row = require_fresh_update(args.target, manifest["cache_max_age_seconds"])
    execute(unit, status_row)
    print(f"UPDATE_RESULT={args.target}:SUCCESS")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"UPDATE_ERROR={exc}", file=sys.stderr)
        raise SystemExit(1)
