#!/usr/bin/env python3
"""Fail-closed dispatcher for one operator-triggered Edge update unit."""

import argparse
import datetime as dt
import json
import os
import pathlib
import shutil
import subprocess
import sys

MANIFEST = pathlib.Path("/opt/edge-maintenance/config/update-units.json")
ENABLEMENT = pathlib.Path("/etc/edge-maintenance/manual-driver-enablement.json")
CACHE = pathlib.Path("/var/www/maintenance-status/maintenance.json")
CORE_UID = 1000


def load(path):
    return json.loads(path.read_text(encoding="utf-8"))


def units():
    data = load(MANIFEST)
    return data, {unit["id"]: unit for unit in data["units"]}


def run(argv, **kwargs):
    print("RUN=" + " ".join(argv), flush=True)
    subprocess.run(argv, check=True, **kwargs)


def normalized_image_reference(reference):
    for prefix in ("docker.io/", "index.docker.io/"):
        if reference.startswith(prefix):
            return reference[len(prefix):]
    return reference


def preflight(unit):
    driver = unit["driver"]
    if driver == "compose":
        directory = pathlib.Path(unit["directory"])
        for item in unit["files"]:
            if not (directory / item).is_file():
                raise RuntimeError(f"missing compose file: {directory / item}")
        run(["docker", "compose", *sum((["-f", f] for f in unit["files"]), []), "config", "--quiet"], cwd=directory)
    elif driver == "user_cli":
        if not pathlib.Path(unit["binary"]).is_file():
            raise RuntimeError(f"missing CLI: {unit['binary']}")
    elif driver == "maintctl" and not pathlib.Path("/usr/local/bin/maintctl").is_file():
        raise RuntimeError("missing maintctl")
    elif driver == "github_binary" and not pathlib.Path(f"/usr/local/bin/{unit['id'].lower()}").is_file():
        raise RuntimeError("missing installed binary")
    elif driver == "apt" and not shutil.which("apt-get"):
        raise RuntimeError("missing apt-get")
    print(f"DRIVER_PREFLIGHT={unit['id']}:PASS")


def require_enablement(target):
    if not ENABLEMENT.is_file():
        raise RuntimeError("manual driver enablement registry absent; driver is locked")
    enablement = load(ENABLEMENT)
    if enablement.get("schema") != 1 or enablement.get("enabled", {}).get(target) is not True:
        raise RuntimeError(f"manual driver is disabled: {target}")


def require_fresh_update(target, max_age):
    data = load(CACHE)
    stamp = dt.datetime.fromisoformat(data["generated_at"].replace("Z", "+00:00"))
    age = (dt.datetime.now(dt.timezone.utc) - stamp).total_seconds()
    if age > max_age:
        raise RuntimeError(f"maintenance cache is stale ({int(age)}s)")
    row = next((row for row in data.get("rows", []) if row.get("component") == target), None)
    if not row:
        raise RuntimeError("target absent from maintenance cache")
    if row.get("status") != "UPDATE_AVAILABLE":
        raise RuntimeError(f"target is not actionable: {row.get('status')}")
    return row


def require_master_update(target, generated_at):
    enablement = load(ENABLEMENT) if ENABLEMENT.is_file() else {}
    if enablement.get("schema") != 1 or enablement.get("master") is not True:
        raise RuntimeError("Master Batch acceptance pending")
    data = load(CACHE)
    if data.get("generated_at") != generated_at:
        raise RuntimeError("maintenance cache changed after Master plan acceptance")
    row = next((row for row in data.get("rows", []) if row.get("component") == target), None)
    if not row:
        raise RuntimeError("target absent from accepted Master cache")
    if row.get("status") != "UPDATE_AVAILABLE":
        raise RuntimeError(f"Master target is not actionable: {row.get('status')}")
    return row


def execute(unit, status_row):
    driver = unit["driver"]
    if driver == "apt":
        env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
        run(["apt-get", "update"], env=env)
        run(["apt-get", "-y", "upgrade"], env=env)
        run(["dpkg", "--audit"])
    elif driver == "maintctl":
        run(["/usr/local/bin/maintctl", "update", unit["argument"], "latest"])
    elif driver == "github_binary":
        command = ["/opt/edge-maintenance/scripts/update-github-binary", unit["id"]]
        if unit["id"] == "SEMAPHORE":
            run(["systemd-run", "--wait", "--collect", "--unit=edge-maintenance-semaphore-update", *command])
        else:
            run(command)
    elif driver == "compose":
        directory = pathlib.Path(unit["directory"])
        compose = ["docker", "compose", *sum((["-f", f] for f in unit["files"]), [])]
        repository = str(status_row.get("image_repository") or "")
        track = str(status_row.get("image_track") or "")
        digest = str(status_row.get("remote_image_digest") or "")
        if not repository or not track or not digest.startswith("sha256:"):
            raise RuntimeError("fresh registry image identity is incomplete")
        image = f"{repository}:{track}"
        pinned = f"{repository}@{digest}"
        config = subprocess.run(
            compose + ["config", "--format", "json"],
            cwd=directory,
            check=True,
            capture_output=True,
            text=True,
        )
        configured = str(
            json.loads(config.stdout)
            .get("services", {})
            .get(unit["service"], {})
            .get("image", "")
        )
        if normalized_image_reference(configured) != normalized_image_reference(image):
            raise RuntimeError(
                f"compose image mismatch: expected {image}, configured {configured or 'absent'}"
            )
        if unit["id"] == "POSTGRESQL":
            backup = pathlib.Path("/var/backups/edge-maintenance") / ("postgres-" + dt.datetime.now().strftime("%Y%m%d-%H%M%S") + ".sql")
            backup.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            with backup.open("wb") as handle:
                subprocess.run(compose + ["exec", "-T", unit["service"], "pg_dumpall", "-U", "mmuser"], cwd=directory, check=True, stdout=handle)
        run(["docker", "pull", pinned])
        run(["docker", "tag", pinned, image])
        run(
            compose
            + ["up", "-d", "--wait", "--force-recreate", unit["service"]],
            cwd=directory,
        )
    elif driver == "user_cli":
        run(["runuser", "-u", "core", "--", unit["binary"], *unit["arguments"]])
        for service in unit.get("services", []):
            run(["runuser", "-u", "core", "--", "env", f"XDG_RUNTIME_DIR=/run/user/{CORE_UID}", "systemctl", "--user", "restart", service])
        if unit.get("system_service"):
            run(["systemctl", "restart", unit["system_service"]])
    else:
        raise RuntimeError(f"unsupported driver: {driver}")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("target")
    parser.add_argument("--preflight", action="store_true")
    parser.add_argument("--master-batch-generated-at")
    args = parser.parse_args()
    manifest, index = units()
    if args.target not in index:
        raise RuntimeError("target is not in the fixed allowlist")
    unit = index[args.target]
    preflight(unit)
    if args.preflight:
        print("REAL_UPDATE_EXECUTED=NO")
        return
    require_enablement(args.target)
    if args.master_batch_generated_at:
        if unit.get("master_policy") == "individual_only":
            raise RuntimeError(f"Master target requires individual update: {args.target}")
        status_row = require_master_update(args.target, args.master_batch_generated_at)
    else:
        status_row = require_fresh_update(args.target, manifest["cache_max_age_seconds"])
    execute(unit, status_row)
    print(f"UPDATE_RESULT={args.target}:SUCCESS")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print(f"UPDATE_RESULT=FAILED:{exc}", file=sys.stderr)
        raise SystemExit(1)
