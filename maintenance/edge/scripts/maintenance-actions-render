#!/usr/bin/env python3
"""Render actionable Semaphore template bindings for update.escloud.us."""

import json
import os
import pathlib
import sys

BASE = pathlib.Path("/opt/edge-maintenance")
MANIFEST_FILE = BASE / "config/update-units.json"
TEMPLATES_FILE = BASE / "config/semaphore-templates.json"
ENABLEMENT_FILE = (
    pathlib.Path("/etc/edge-maintenance/manual-driver-enablement.json")
)
OUTPUT_FILE = pathlib.Path("/var/www/maintenance-status/actions.json")


def load(path):
    return json.loads(path.read_text(encoding="utf-8"))


def build_actions(manifest, templates, enablement):
    if (
        manifest.get("schema") != 2
        or manifest.get("ownership_mode") != "native_first_hybrid"
    ):
        raise RuntimeError("invalid maintenance units manifest")
    if templates.get("schema") != 2:
        raise RuntimeError("invalid Semaphore template mapping")
    if enablement.get("schema") != 2:
        raise RuntimeError("invalid manual driver enablement registry")

    units = manifest.get("units", [])
    manual_ids = {unit["id"] for unit in units}
    template_map = templates.get("components", {})
    enabled_map = enablement.get("enabled", {})

    if (
        len(units) != len(manual_ids)
        or len(manual_ids) != 16
        or set(template_map) != manual_ids
        or set(enabled_map) != manual_ids
    ):
        raise RuntimeError("manual action inputs disagree")

    template_ids = [
        item.get("template_id")
        for item in template_map.values()
    ]
    if None in template_ids or len(template_ids) != len(set(template_ids)):
        raise RuntimeError("manual template IDs are invalid")
    if templates.get("refresh_template_id") != 1:
        raise RuntimeError("refresh template mapping must be ID 1")
    if templates.get("master_template_id") != 18:
        raise RuntimeError("Master template mapping must be ID 18")

    managed_by = {
        "apt": "apt",
        "compose": "docker",
        "nextcloud_compose": "docker",
        "stalwart_compose": "docker",
        "plane_compose": "docker",
        "user_cli": "user_or_git",
        "maintctl": "native",
        "github_binary": "native",
        "self_update": "native",
    }

    components = {}
    for unit in units:
        target = unit["id"]
        mapping = template_map[target]
        enabled = enabled_map[target] is True
        components[target] = {
            "template_id": mapping["template_id"] if enabled else None,
            "label": mapping["label"],
            "group": unit["group"],
            "managed_by": managed_by[unit["driver"]],
            "update_owner": "maintenance_manual",
            "driver_state": "executable" if enabled else "acceptance_pending",
            "disabled_reason": "" if enabled else "Manual driver acceptance pending",
        }

    master_enabled = enablement.get("master") is True

    return {
        "schema": 10,
        "target_model": "update_units_v5",
        "project_id": templates["project_id"],
        "master_template_id": templates["master_template_id"] if master_enabled else None,
        "refresh_template_id": templates["refresh_template_id"],
        "execution_mode": "manual_only",
        "auto_update": False,
        "components": components,
    }


def main():
    manifest = load(MANIFEST_FILE)
    templates = load(TEMPLATES_FILE)
    enablement = load(ENABLEMENT_FILE)
    actions = build_actions(manifest, templates, enablement)
    tmp_path = OUTPUT_FILE.with_name(f"{OUTPUT_FILE.name}.tmp.{os.getpid()}")
    tmp_path.write_text(json.dumps(actions, indent=2) + "\n", encoding="utf-8")
    tmp_path.replace(OUTPUT_FILE)
    OUTPUT_FILE.chmod(0o644)
    print(
        f"ACTIONS_RENDER=PASS|SCHEMA={actions['schema']}|COMPONENTS={len(actions['components'])}"
    )


if __name__ == "__main__":
    main()
