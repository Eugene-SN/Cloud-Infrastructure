#!/usr/bin/env python3
"""Operator-triggered OpenProject Docker update using the upstream Compose lifecycle."""

import argparse
import json
import os
import pathlib
import subprocess
import sys
import time
import urllib.request

DIRECTORY = pathlib.Path("/opt/openproject")
COMPOSE_FILES = ["docker-compose.yml", "docker-compose.override.yml"]
HEALTH_URL = "http://127.0.0.1:18082/health_checks/default"
ROLLBACK_CONTAINERS = ["openproject-db-1", "openproject-hocuspocus-1"]
READY_ATTEMPTS = 40
READY_DELAY_SECONDS = 3


def run(argv, **kwargs):
    print("RUN=" + " ".join(argv), flush=True)
    return subprocess.run(argv, check=True, **kwargs)


def compose_argv(*args):
    argv = ["docker", "compose"]
    for name in COMPOSE_FILES:
        argv.extend(["-f", name])
    argv.extend(args)
    return argv


def compose_run(*args, **kwargs):
    return run(compose_argv(*args), cwd=DIRECTORY, **kwargs)


def check_git_clean():
    if not DIRECTORY.is_dir():
        raise RuntimeError(f"OpenProject directory missing: {DIRECTORY}")

    branch = subprocess.run(
        ["git", "-c", "safe.directory=/opt/openproject", "rev-parse", "--abbrev-ref", "HEAD"],
        cwd=DIRECTORY,
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()

    if branch != "stable/17":
        raise RuntimeError(f"OpenProject git branch unexpected: {branch} (expected stable/17)")

    tracked_diff = subprocess.run(
        ["git", "-c", "safe.directory=/opt/openproject", "diff", "--quiet"],
        cwd=DIRECTORY,
        capture_output=True,
    )
    if tracked_diff.returncode != 0:
        raise RuntimeError("OpenProject tracked working tree has uncommitted modifications")

    staged_diff = subprocess.run(
        ["git", "-c", "safe.directory=/opt/openproject", "diff", "--cached", "--quiet"],
        cwd=DIRECTORY,
        capture_output=True,
    )
    if staged_diff.returncode != 0:
        raise RuntimeError("OpenProject git index has staged modifications")


def check_compose_files():
    for f in COMPOSE_FILES:
        path = DIRECTORY / f
        if not path.is_file():
            raise RuntimeError(f"missing OpenProject compose file: {path}")

    config = subprocess.run(
        compose_argv("config", "--quiet"),
        cwd=DIRECTORY,
        capture_output=True,
        text=True,
    )
    if config.returncode != 0:
        raise RuntimeError(f"OpenProject compose config invalid: {config.stderr.strip()}")


def health_probe():
    try:
        req = urllib.request.Request(HEALTH_URL, headers={"User-Agent": "Edge-Maintenance"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            body = resp.read().decode("utf-8", errors="replace")
            if resp.status == 200 and "PASSED" in body:
                return True, body.strip()
            return False, f"status={resp.status} body={body.strip()}"
    except Exception as exc:
        return False, str(exc)


def check_rollback_containers():
    for name in ROLLBACK_CONTAINERS:
        proc = subprocess.run(
            ["docker", "inspect", name, "--format", "{{.State.Running}}"],
            capture_output=True,
            text=True,
        )
        if proc.returncode != 0:
            raise RuntimeError(f"Stage 1 rollback container missing: {name}")
        running = proc.stdout.strip()
        if running == "true":
            raise RuntimeError(f"Stage 1 rollback container unexpectedly running: {name}")


def preflight():
    check_git_clean()
    check_compose_files()

    running = subprocess.run(
        ["docker", "inspect", "openproject-web-1", "--format", "{{.State.Running}}"],
        capture_output=True,
        text=True,
    ).stdout.strip()
    if running != "true":
        raise RuntimeError("openproject-web-1 is not running")

    ok, detail = health_probe()
    if not ok:
        raise RuntimeError(f"OpenProject health check failed: {detail}")

    check_rollback_containers()
    print("OPENPROJECT_UPDATE_PREFLIGHT=PASS")


def execute_update():
    preflight()

    # 1. Update git tracked files on stable/17
    run(["git", "-c", "safe.directory=/opt/openproject", "pull", "--ff-only", "origin", "stable/17"], cwd=DIRECTORY)

    # 2. Pull updated images ignoring buildable proxy
    compose_run("pull", "--ignore-buildable")

    # 3. Bring up updated services WITHOUT --remove-orphans to preserve rollback containers!
    compose_run("up", "-d", "--wait")

    # 4. Wait for application readiness
    ready = False
    last_err = ""
    for attempt in range(1, READY_ATTEMPTS + 1):
        ok, detail = health_probe()
        if ok:
            print(f"OPENPROJECT_RUNTIME_READY_GATE=PASS|ATTEMPT={attempt}|DETAIL={detail}")
            ready = True
            break
        last_err = detail
        print(f"OPENPROJECT_RUNTIME_WAIT|ATTEMPT={attempt}|DETAIL={detail}", flush=True)
        time.sleep(READY_DELAY_SECONDS)

    if not ready:
        raise RuntimeError(f"OpenProject runtime readiness timeout: {last_err}")

    # 5. Verify rollback containers remain intact
    check_rollback_containers()

    print("OPENPROJECT_UPDATE_RESULT=SUCCESS")


def main():
    parser = argparse.ArgumentParser(description="OpenProject Compose update driver")
    parser.add_argument("--preflight", action="store_true", help="Perform preflight verification only")
    args = parser.parse_args()

    if args.preflight:
        preflight()
    else:
        execute_update()


if __name__ == "__main__":
    main()
