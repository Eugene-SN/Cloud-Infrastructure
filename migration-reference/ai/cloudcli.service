[Unit]
Description=CloudCLI AI Coding Web UI
Documentation=https://cloudcli.ai
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=core
Group=core
WorkingDirectory=/srv/ai-workspace

Environment=HOME=/home/core
Environment=USER=core
Environment=LOGNAME=core
Environment=PATH=/home/core/.nvm/versions/node/v22.23.2/bin:/home/core/.local/bin:/usr/bin:/bin

Environment=NODE_ENV=production

Environment=HOST=127.0.0.1
Environment=SERVER_HOST=127.0.0.1
Environment=SERVER_PORT=18140

Environment=WORKSPACES_ROOT=/srv/ai-workspace
Environment=DATABASE_PATH=/home/core/.cloudcli/auth.db

ExecStart=/home/core/.local/bin/cloudcli --port 18140 --database-path /home/core/.cloudcli/auth.db

Restart=on-failure
RestartSec=3s

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
