+import os,unittest,tempfile
+from pathlib import Path
+import pymupdf
+from pdf_cleanup.core import cleanup,analyze,validate_output
+from pdf_cleanup.native import inspect_pdf,remove_text_shows
+
+class RefinementTests(unittest.TestCase):
+ def setUp(self):
+  self.tmp=tempfile.TemporaryDirectory(dir=os.environ.get('TMPDIR'));self.root=Path(self.tmp.name)
+ def tearDown(self):self.tmp.cleanup()
+ def make(self,baseline,inline):
+  doc=pymupdf.open()
+  for n in (1,2):
+   page=doc.new_page(width=612,height=792);page.insert_text((72,100),'Useful body',fontsize=11)
+   page.insert_text((72,baseline),inline.format(n=n),fontsize=9)
+  path=self.root/'input.pdf';doc.save(path);doc.close();return path
+ def test_interior_numbered_settings_are_not_pagination(self):
+  inp=self.make(200,'Required setting {n}');out=self.root/'out.pdf'
+  result=cleanup(inp,out)
+  self.assertEqual(result['header_footer_fragments'],0)
+  with pymupdf.open(out) as doc:self.assertIn('Required setting 1',doc[0].get_text())
+ def test_numbered_server_port_captions_are_preserved(self):
+  inp=self.make(658,'{n} USB / OCP port');out=self.root/'out.pdf'
+  result=cleanup(inp,out)
+  self.assertEqual(result['header_footer_fragments'],0)
+  with pymupdf.open(out) as doc:self.assertIn('USB / OCP port',doc[0].get_text())
+ def test_inline_footer_without_large_gap_is_removed(self):
+  inp=self.make(755,'Server manual {n}');out=self.root/'out.pdf';cleanup(inp,out)
+  with pymupdf.open(out) as doc:
+   self.assertIn('Useful body',doc[0].get_text());self.assertNotIn('Server manual',doc[0].get_text())
+ def precision_fixture(self):
+  doc=pymupdf.open();streams=[]
+  for n in (1,2):
+   page=doc.new_page(width=612,height=792);page.insert_text((72,100),'Body',fontsize=11)
+   stream=(b'% keep unusual lexical precision\nq 1.0000000000000001 0 0 1 0 0 cm\n'
+           b'BT /helv 11.0000000000000001 Tf 1 0 0 1 72.1234567890123 692 Tm (Energy Perf BIAS) Tj ET\n'
+           b'q 1 0 0 1 72 400 cm BI /W 1 /H 1 /CS /RGB /BPC 8 ID \x01\x02\x03 EI Q\n'
+           b'BT /helv 9 Tf 1 0 0 1 490 37 Tm ('+str(n).encode()+b') Tj ET\n'
+           b'BT /helv 8 Tf 1 0 0 1 350 37 Tm 0.000000000000001 0 (Footer) " ET\nQ\n')
+   doc.update_stream(page.get_contents()[0],stream);streams.append(stream)
+  inp=self.root/'precision.pdf';doc.save(inp);doc.close();return inp,streams
+ def test_cleanup_keeps_every_other_stream_byte(self):
+  inp,streams=self.precision_fixture();out=self.root/'out.pdf';cleanup(inp,out)
+  with pymupdf.open(out) as doc:
+   for i,page in enumerate(doc):
+    expected=streams[i].replace(b'('+str(i+1).encode()+b') Tj',b'() Tj').replace(b'(Footer) "',b'() "')
+    self.assertEqual(page.read_contents(),expected)
+ def test_removal_keeps_every_other_stream_byte(self):
+  inp,streams=self.precision_fixture();native=inspect_pdf(inp)
+  with pymupdf.open(inp) as source:
+   plan=analyze(source,native)
+   with pymupdf.open(inp) as target:
+    remove_text_shows(target,inp,plan)
+    for i,page in enumerate(target):
+     expected=streams[i].replace(b'('+str(i+1).encode()+b') Tj',b'() Tj').replace(b'(Footer) "',b'() "')
+     self.assertEqual(page.read_contents(),expected)
+    out=self.root/'out.pdf';target.save(out,garbage=2,deflate=True,use_objstms=1)
+   validate_output(out,source,plan,native)
