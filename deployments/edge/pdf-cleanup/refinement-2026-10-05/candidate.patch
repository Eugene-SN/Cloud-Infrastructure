+"""Locate operands using pypdf's PDF-object and inline-image parsers.
+
+The program retains its original bytes: get_data() after parsing would otherwise
+serialize every number, string and instruction, including untouched body text.
+Parser control flow follows pypdf 6.19.0 ContentStream._parse_content_stream.
+"""
+from pypdf.generic import ContentStream, NameObject, read_object
+from pypdf._utils import read_non_whitespace, read_until_regex
+
+
+class LocatedContentStream(ContentStream):
+    def _parse_content_stream(self, stream):
+        self.original_bytes = stream.getvalue()
+        self.operand_ranges = []
+        self.operator_ranges = []
+        operands = []; ranges = []
+        stream.seek(0)
+        while True:
+            first = read_non_whitespace(stream)
+            if not first: break
+            stream.seek(-1, 1); start = stream.tell()
+            if first == b'%':
+                while first not in (b'\r', b'\n', b''): first = stream.read(1)
+                continue
+            if first.isalpha() or first in (b"'", b'"'):
+                operator = read_until_regex(stream=stream, regex=NameObject.delimiter_pattern,
+                                            length=self._OPERATOR_LENGTH_LIMIT)
+                if operator == b'BI':
+                    if operands: raise ValueError('Unexpected inline-image operands')
+                    operands = self._read_inline_image(stream)
+                    operator = b'INLINE IMAGE'
+                self._operations.append((operands, operator))
+                self.operand_ranges.append(ranges)
+                self.operator_ranges.append((start, stream.tell()))
+                operands = []; ranges = []
+            else:
+                operands.append(read_object(stream, None, self.forced_encoding))
+                ranges.append((start, stream.tell()))
+        if operands: raise ValueError('Trailing content operands without an operator')
+
+
+def edited_program(program, edits):
+    """Replace only proven target operands/invocations, preserving other bytes."""
+    result = bytearray(); previous = 0
+    for start, end, replacement in sorted(edits):
+        if start < previous or end < start or end > len(program):
+            raise ValueError('Overlapping or invalid PDF operand edits')
+        result.extend(program[previous:start]); result.extend(replacement); previous = end
+    result.extend(program[previous:])
+    return bytes(result)
