+def body_signature(lines, selected=()):
+    """Preserve body glyph order and style, in addition to coordinates."""
+    return [{'c':c['c'],'origin':c['origin'],'font':span['font'],
+             'size':span['size'],'flags':span['flags'],'color':span['color'],'alpha':span['alpha'],
+             'dir':line['dir']}
+            for i,line in enumerate(lines) if i not in selected
+            for span in line['spans'] for c in span['chars']]
+
+def body_style_signature(page, lines, selected=()):
+    """Keep semantic text; compare visual style only where a real glyph exists.
+
+    Zero-width semantic characters without a texttrace glyph have no painted
+    font/opacity. MuPDF can assign them the last font used elsewhere on the page.
+    Their Unicode, position and order remain mandatory, including whitespace.
+    """
+    drawn={(round(c[2][0],4),round(c[2][1],4))
+           for span in page.get_texttrace() for c in span['chars']}
+    result=[]
+    for i,line in enumerate(lines):
+        if i in selected: continue
+        for span in line['spans']:
+            for c in span['chars']:
+                item={'c':c['c'],'origin':c['origin']}
+                zero_width=abs(c['bbox'][2]-c['bbox'][0])<=1e-7
+                point=(round(c['origin'][0],4),round(c['origin'][1],4))
+                if not zero_width or point in drawn:
+                    item.update(font=span['font'],size=span['size'],flags=span['flags'],
+                                color=span['color'],alpha=span['alpha'],dir=line['dir'])
+                result.append(item)
+    return result
+
