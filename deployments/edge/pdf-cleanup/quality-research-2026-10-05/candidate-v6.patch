+def visible_drawings(page):
+    """Respect nested PDF clipping before testing enclosing drawing frames."""
+    result = []; clips = {}
+    for drawing in page.get_drawings(extended=True):
+        level = drawing['level']
+        clips = {depth:rect for depth,rect in clips.items() if depth < level}
+        if drawing['type'] == 'clip':
+            clips[level] = drawing['scissor']; continue
+        if drawing['type'] == 'group': continue
+        rect = pymupdf.Rect(drawing['rect'])
+        for clip in clips.values(): rect &= clip
+        if not rect.is_empty:
+            result.append(dict(drawing, rect=rect))
+    return result
+
