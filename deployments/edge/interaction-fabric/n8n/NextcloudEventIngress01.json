{
  "id": "bxsXXufaaXuubA3Z",
  "name": "NextcloudEventIngress01",
  "nodes": [
    {
      "id": "6d4e429b-040c-49e9-8cbc-06f9b7ac20b8",
      "name": "Nextcloud Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "nextcloud-events",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "08fc5a00-67a9-4546-b531-eb7daed16a7e",
      "credentials": {
        "httpHeaderAuth": {
          "id": "dju3iGLC4SWK191K",
          "name": "Nextcloud event ingress"
        }
      }
    },
    {
      "id": "d776afa4-d869-4d63-b28e-81283111807f",
      "name": "Normalize Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "jsCode": "const b=$json.body;\nconst allowed=['NodeCreatedEvent','NodeWrittenEvent','NodeDeletedEvent','NodeRenamedEvent'];\nif (!b?.event || !allowed.some(n=>b.event.class === 'OCP\\\\Files\\\\Events\\\\Node\\\\'+n)) throw new Error('Unsupported Nextcloud event');\nreturn [{json:{event_class:b.event.class,path:b.event.node?.path ?? b.event.source?.path ?? '',user_id:b.user?.uid ?? '',payload:JSON.stringify(b)}}];"
      }
    },
    {
      "id": "f1f8911e-8869-468c-9e0e-01543e091c8a",
      "name": "Durable Intake",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        400,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "pZDk2S89xgYGSXEO"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "event_class": "={{ $json.event_class }}",
            "path": "={{ $json.path }}",
            "user_id": "={{ $json.user_id }}",
            "payload": "={{ $json.payload }}"
          }
        },
        "options": {}
      }
    },
    {
      "id": "c938854f-ae85-4a48-af39-f20a7a07ffbb",
      "name": "Stored",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        600,
        0
      ],
      "parameters": {
        "respondWith": "noData",
        "options": {
          "responseCode": 204
        }
      }
    }
  ],
  "connections": {
    "Nextcloud Event": {
      "main": [
        [
          {
            "node": "Normalize Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Event": {
      "main": [
        [
          {
            "node": "Durable Intake",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Durable Intake": {
      "main": [
        [
          {
            "node": "Stored",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionTimeout": 30
  },
  "description": "Authenticated native Nextcloud file events → durable Data Table intake. Created/written/deleted/renamed only; acknowledges204 after storage. No business workflow or notifications."
}
