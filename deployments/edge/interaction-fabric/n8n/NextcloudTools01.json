    {
      "id": "903781df-3f0c-4407-bd10-4b72e0a5ff04",
      "name": "Binary Upload Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        0
      ],
      "parameters": {
        "jsCode": "const b=typeof $json.content_base64 === 'string' ? Buffer.from($json.content_base64,'base64') : Buffer.from($json.content,'utf8');return [{json:$json,binary:{data:await this.helpers.prepareBinaryData(b,$json.path.split('/').pop(),$json.mime_type ?? 'application/octet-stream')}}];"
      }
    },
    {
      "id": "63665d17-f44a-40ee-8f9a-09b65ef0d37a",
      "name": "Tool Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        0
      ],
      "parameters": {
        "jsCode": "const p=$('Validate Operation').first().json;const rows=$input.all();\nlet result=rows.map(x=>x.json);let error=result.find(x=>x.error || (x.statusCode && (x.statusCode<200 || x.statusCode>=300)));\nif (p.operation==='download' && !error) {\n const b=await this.helpers.getBinaryDataBuffer(0,'data');\n result={content_base64:b.toString('base64'),content:b.toString('utf8'),size:b.length,mime_type:rows[0].binary?.data?.mimeType};\n} else if (p.operation==='find') result=result.filter(x=>JSON.stringify(x).toLowerCase().includes(String(p.query ?? '').toLowerCase()));\nelse if (result.length===1) result=result[0];\nif (p.operation==='metadata') { const http=$('WebDAV Metadata').first().json; error=error ?? (http.statusCode<200 || http.statusCode>=300 ? http : undefined); result={http_status:http.statusCode,webdav:result}; }\nelse if (['mkdir','upload','move','copy','delete','revoke_share'].includes(p.operation)) result={http_status:result.statusCode,response:result.data ?? result.body};\nreturn [{json:{operation:p.operation,path:p.path,ok:!error,result,...(error?{error}:{} )}}];"
      }
    },
