    {
      "id": "8b5c7554-b588-4499-a4f4-8d6948f8e991",
      "name": "Validate Operation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "jsCode": "const p=$json.body ?? $json;\nconst ops=['list','find','metadata','upload','download','mkdir','move','copy','share','revoke_share','delete'];\nif (!ops.includes(p.operation)) throw new Error('Unsupported Nextcloud operation');\nconst path=p.path ?? '/';\nif (typeof path!=='string' || path.split('/').some(s=>s==='..') || /[?#\\\\]/.test(path)) throw new Error('path must be a relative vault file path without query/fragment/traversal');\nif (['move','copy'].includes(p.operation) && (typeof p.to_path!=='string' || p.to_path.split('/').some(s=>s==='..') || /[?#\\\\]/.test(p.to_path))) throw new Error('valid to_path required');\nif (p.operation==='upload' && typeof p.content!=='string' && typeof p.content_base64!=='string') throw new Error('content or content_base64 required');\nif (p.operation==='revoke_share' && !/^\\d+$/.test(String(p.share_id))) throw new Error('numeric share_id required');\nreturn [{json:{...p,path,encoded_path:path.split('/').map(encodeURIComponent).join('/'),native_operation:{find:'list',mkdir:'create'}[p.operation] ?? p.operation,resource:['list','find','mkdir'].includes(p.operation) ? 'folder':'file'}}];"
      }
    },
    {
      "id": "9fb059c5-0643-4a29-9278-ad35b6c72ffb",
      "name": "Operation",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 11,
        "output": "={{ ['list','find','metadata','upload','download','mkdir','move','copy','share','revoke_share','delete'].indexOf($json.operation) }}"
