#!/usr/bin/python3
"""One-shot host CLI execution. No shell expansion, listener, or fallback."""
import base64,fcntl,json,math,os,pathlib,re,signal,subprocess,sys,tempfile,time,uuid
STATE=pathlib.Path('/home/core/.local/state/edge-ai-exec')
MAX_CONCURRENT=2

def output(**v):
    print(json.dumps(v,ensure_ascii=False),flush=True)

def stop_group(proc):
    if proc.poll() is None:
        os.killpg(proc.pid,signal.SIGTERM)
        try:proc.wait(timeout=5)
        except subprocess.TimeoutExpired:os.killpg(proc.pid,signal.SIGKILL);proc.wait()

def stream_result(stdout):
    events=[json.loads(line) for line in stdout.splitlines() if line.strip()]
    initial=[e for e in events if e.get('event')=='init']
    results=[e.get('result') for e in events if e.get('event')=='result']
    if len(initial)!=1 or len(results)!=1 or not isinstance(results[0],dict):
        raise ValueError('stream must contain exactly one initialization and one terminal result')
    native=dict(results[0]); model=initial[0].get('init',{}).get('model')
    if not isinstance(model,str) or not model or native.get('num_turns')!=1:
        raise ValueError('stream must prove the selected model and exactly one turn')
    native['model']=model
    return native

def execute(p):
    rid=p.get('request_id') or str(uuid.uuid4())
    if not isinstance(rid,str) or not re.fullmatch(r'[A-Za-z0-9_-]{1,80}',rid):raise ValueError('invalid request_id')
    STATE.mkdir(mode=0o700,parents=True,exist_ok=True)
    record=STATE/(rid+'.json')
    if p.get('action')=='cancel':
        if not record.exists():output(ok=False,status='not_running',request_id=rid);return
        d=json.loads(record.read_text())
        # Verify PID identity before signalling; cancellation addresses this helper only.
        if pathlib.Path('/proc/'+str(d['pid'])+'/stat').read_text().split()[21]!=d['start_ticks']:raise ValueError('PID identity changed')
        os.kill(d['pid'],signal.SIGTERM);output(ok=True,status='cancel_requested',request_id=rid);return
    backend=p.get('backend');task=p.get('task');cwd=p.get('cwd','/home/core/projects/cloud-infrastructure');timeout=p.get('timeout',300)
    if backend not in ('codex','antigravity'):raise ValueError('unsupported CLI backend')
    if not isinstance(task,str) or not task.strip():raise ValueError('task must be a non-empty string')
    if not isinstance(cwd,str) or not pathlib.Path(cwd).is_absolute() or not pathlib.Path(cwd).is_dir():raise ValueError('cwd must be an existing absolute directory')
    if isinstance(timeout,bool) or not isinstance(timeout,(int,float)) or not 1<=timeout<=3600:raise ValueError('timeout must be 1..3600 seconds')
    mode=p.get('output_mode','text');schema=p.get('schema')
    if mode not in ('text','json'):raise ValueError('output_mode must be text or json')
    if schema is not None and not isinstance(schema,dict):raise ValueError('schema must be JSON object')
    # Preserve accepted n8n legacy callers. Hermes commands always supply read-only
    # unless the operator explicitly supplies a write/full-access contract.
    permission=p.get('permission_mode','full-access')
    if permission not in ('read-only','workspace-write','full-access'):raise ValueError('permission_mode must be read-only, workspace-write, or full-access')
    if backend=='antigravity' and permission=='workspace-write':raise ValueError('Antigravity has no Codex-equivalent workspace-write policy; choose read-only (native plan) or explicitly authorized full-access')
    stream=p.get('input_transport')=='stream-json-v1'
    if p.get('input_transport') not in (None,'stream-json-v1'):raise ValueError('unsupported input transport')
    if stream and (backend!='antigravity' or p.get('context_policy')!='isolated-home-v1'):raise ValueError('stream transport requires isolated validator')
    context_policy=p.get('context_policy');context_home=None
    if context_policy is not None:
        if (context_policy!='isolated-home-v1' or backend!='antigravity' or permission!='read-only'
                or mode!='json' or schema is None or p.get('agent')!='documentation-validation'):
            raise ValueError('invalid isolated context policy')
        value=p.get('context_home')
        if not isinstance(value,str):raise ValueError('context home is required')
        context_home=pathlib.Path(value)
        expected=pathlib.Path(cwd)/'home'
        if (context_home!=expected or context_home.is_symlink() or not context_home.is_dir()
                or context_home.resolve()!=expected.absolute()):raise ValueError('invalid context home')
        agent=context_home/'.gemini/antigravity-cli/agents/documentation-validation.md'
        if not agent.is_file() or agent.is_symlink():raise ValueError('missing context agent')
    lock=None
    for slot in range(MAX_CONCURRENT):
        candidate=open(STATE/('slot-'+str(slot)+'.lock'),'a+')
        try:fcntl.flock(candidate,fcntl.LOCK_EX|fcntl.LOCK_NB);lock=candidate;break
        except BlockingIOError:candidate.close()
    if lock is None:output(ok=False,status='busy',exit_code=75,request_id=rid,backend=backend);return
    proc=None;record_created=False;cancelled=False;start=time.monotonic()
    def cancel(sig,frame):
        nonlocal cancelled
        cancelled=True
        if proc is not None:stop_group(proc)
    for sig in (signal.SIGTERM,signal.SIGHUP,signal.SIGINT):signal.signal(sig,cancel)
    try:
        # Exclusive request IDs prevent one call replacing another cancellation record.
        with record.open('x') as rf:
            record_created=True;os.chmod(record,0o600);json.dump({'pid':os.getpid(),'start_ticks':pathlib.Path('/proc/self/stat').read_text().split()[21]},rf)
        with tempfile.TemporaryDirectory(prefix='edge-ai-') as td:
            td=pathlib.Path(td);sp=td/'schema.json';last=td/'result.txt'
            if schema is not None:sp.write_text(json.dumps(schema));sp.chmod(0o600)
            if backend=='codex':
                sandbox='danger-full-access' if permission=='full-access' else permission
                argv=['/home/core/.local/bin/codex','exec','--sandbox',sandbox,'-c','approval_policy="never"','--ephemeral','--json','--color','never','--skip-git-repo-check','-C',cwd,'-o',str(last)]
                if schema is not None:argv+=['--output-schema',str(sp)]
                if p.get('model'):argv+=['--model',str(p['model'])]
                if p.get('effort'):argv+=['-c','model_reasoning_effort='+json.dumps(p['effort'])]
                argv+=['-'];stdin=task
            else:
                # The host deadline wins over AGY's native partial-output timeout.
                argv=['/home/core/.local/bin/agy','-p',task,'--output-format','json','--print-timeout',str(math.ceil(timeout)+5)+'s','--mode','plan' if permission=='read-only' else 'accept-edits']
                if permission=='full-access':argv+=['--dangerously-skip-permissions']
                else:argv+=['--sandbox']
                if schema is not None:argv+=['--json-schema',str(sp)]
                if p.get('model'):argv+=['--model',str(p['model'])]
                if p.get('effort'):argv+=['--effort',str(p['effort'])]
                stdin=None
                if stream:
                    argv=argv[:1]+['--input-format','stream-json','--output-format','stream-json']+argv[5:]
                    stdin=json.dumps({'event':'user','message':{'content':task}})+'\n'
            env=os.environ.copy();env['HOME']='/home/core'
            if context_home is not None:
                # Explicit opt-in only. Existing Hermes/n8n callers keep their exact launch.
                for key in list(env):
                    if key.startswith(('AGY_','ANTIGRAVITY_','GEMINI_')) or key in (
                            'GOOGLE_API_KEY','GOOGLE_GENAI_USE_VERTEXAI','GOOGLE_APPLICATION_CREDENTIALS'):
                        env.pop(key)
                env.update(HOME=str(context_home),XDG_CONFIG_HOME=str(context_home/'.config'),
                           XDG_DATA_HOME=str(context_home/'.local/share'),
                           XDG_CACHE_HOME=str(context_home/'.cache'),
                           XDG_STATE_HOME=str(context_home/'.local/state'),AGY_CLI_DISABLE_AUTO_UPDATE='true')
                # This native metadata command never submits a user turn. Fail before inference
                # if an update changes discovery; AGY otherwise falls back to its default agent.
                registry=subprocess.run(['/home/core/.local/bin/agy','agents'],cwd=cwd,env=env,
                    stdin=subprocess.DEVNULL,capture_output=True,text=True,timeout=10)
                if registry.returncode or set(registry.stdout.splitlines())!={'documentation-validation'}:
                    raise ValueError('isolated context agent discovery failed; no inference')
                argv+=['--agent','documentation-validation','--disable-slash-commands']
            if cancelled:
                output(ok=False,status='canceled',request_id=rid,backend=backend);return
            proc=subprocess.Popen(argv,cwd=cwd,env=env,stdin=subprocess.PIPE if stdin is not None else subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,start_new_session=True)
            status='completed'
            try:stdout,stderr=proc.communicate(stdin,timeout=timeout)
            except subprocess.TimeoutExpired:stop_group(proc);stdout,stderr=proc.communicate();status='timeout'
            if cancelled:status='canceled'
            elif proc.returncode and status=='completed':status='error'
            result=last.read_text() if backend=='codex' and last.exists() else stdout
            if backend=='codex' and status=='completed' and (not last.exists() or not result.strip()):status='missing_final_output'
            native=None
            if backend=='antigravity' and stdout:
                try:
                    native=stream_result(stdout) if stream else json.loads(stdout);result=(native.get('structured_output') if schema is not None and native.get('structured_output') is not None else native.get('result',native.get('response',native))) if isinstance(native,dict) else native
                    if status=='completed' and (not isinstance(native,dict) or native.get('status')!='SUCCESS'):status='native_error'
                    if status=='completed' and native.get('denied_actions'):status='permission_denied'
                except (json.JSONDecodeError,ValueError):
                    if status=='completed':status='invalid_json'
            elif backend=='antigravity' and status=='completed':status='missing_final_output'
            if mode=='json' and isinstance(result,str) and status=='completed':
                try:result=json.loads(result)
                except json.JSONDecodeError:status='invalid_json'
            output(ok=status=='completed',status=status,backend=backend,request_id=rid,exit_code=proc.returncode,duration_s=round(time.monotonic()-start,3),result=result,stderr=stderr[-16384:],native=native,pid=proc.pid,cwd=cwd,home=env['HOME'],permission_mode=permission,**({'context_policy':context_policy} if context_policy else {}),**({'native_stream':stdout} if stream else {}))
    finally:
        if proc is not None:stop_group(proc)
        if record_created:record.unlink(missing_ok=True)
        lock.close()

if __name__=='__main__':
    if sys.argv[1:]==['--capabilities']:
        output(schema_version=1,context_policies=['isolated-home-v1'],input_transports=['request-json-stdin-v1','stream-json-v1']);sys.exit(0)
    try:
        payload=json.load(sys.stdin) if sys.argv[1:]==['--request-json-stdin'] else json.loads(base64.b64decode(sys.argv[1],validate=True))
        execute(payload)
    except Exception as exc:output(ok=False,status='invalid_request',exit_code=64,error=str(exc))
