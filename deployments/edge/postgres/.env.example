# PostgreSQL 18 Service Environment Contract
# Runtime location: /opt/postgres/.env (permissions 0600, root:root)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME_POSTGRES_SUPERUSER_PASSWORD
POSTGRES_DB=postgres

# Mattermost database & credentials
MATTERMOST_DB_USER=mattermost
MATTERMOST_DB_PASSWORD=CHANGEME_MATTERMOST_PASSWORD
MATTERMOST_DB_NAME=mattermost

# Nextcloud database & credentials
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=CHANGEME_NEXTCLOUD_PASSWORD
NEXTCLOUD_DB_NAME=nextcloud

# OpenProject database & credentials
OPENPROJECT_DB_USER=openproject
OPENPROJECT_DB_PASSWORD=CHANGEME_OPENPROJECT_PASSWORD
OPENPROJECT_DB_NAME=openproject
