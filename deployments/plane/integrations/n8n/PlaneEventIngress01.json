      "parameters": {
        "jsCode": "const x=$input.first().json;const supplied=String(x.headers?.['x-plane-signature']||'').toLowerCase();const expected=String(x.computedHmac||'');let diff=0;for(let i=0;i<64;i++)diff|=(supplied.charCodeAt(i)||0)^(expected.charCodeAt(i)||0);const valid=/^[a-f0-9]{64}$/.test(supplied)&&expected.length===64&&diff===0;\nconst b=x.body||{};const action=({created:'create',updated:'update',deleted:'delete',create:'create',update:'update',delete:'delete'})[b.action];const project=b.data?.project?.id||b.data?.project||b.data?.project_id;const accepted=valid&&b.event==='issue'&&x.headers?.['x-plane-event']==='issue'&&b.workspace_id==='efd9a5ab-d149-44b4-ad64-60e8d3c8e19a'&&b.workspace_slug==='personal'&&b.webhook_id==='e5b6c10c-d447-4fd0-90b9-a761998d3234'&&action&&b.data?.id&&(action==='delete'||project==='0be26f75-fc5b-4e15-9d69-efc4cca4e65d');\nreturn [{json:{valid,accepted:Boolean(accepted),event_key:accepted?b.data.id+':'+action:'',issue_id:b.data?.id||'',action:action||'',payload:JSON.stringify({...b,action})}}];",
