      "id": "c7dac83a-a608-43dd-9dde-a93cb0821e3a",
      "name": "Prepare Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        100
      ],
      "parameters": {
        "jsCode": "const row=$('Each Event').first().json;const b=JSON.parse(row.payload);const previous=$input.first().json;const old=previous.context?JSON.parse(previous.context):null;const d=b.action==='delete'?old:b.data;const project=d?.project?.id||d?.project||d?.project_id;\nconst idOf=x=>x?.id||x||null;const label=x=>x?.name||x?.display_name||x?.email||x?.id||x||'none';\nconst semantic=x=>({name:x.name||'',state:idOf(x.state),priority:x.priority||'none',assignees:(x.assignees||x.assignee_ids||[]).map(idOf).sort(),due:x.target_date||x.due_date||null});\nlet notify=false,message='',fingerprint=previous.fingerprint||'',context=previous.context||'',last_action=previous.last_action||'';\nconst stale=b.action!=='delete'&&old&&d?.updated_at&&old.updated_at&&Date.parse(d.updated_at)<Date.parse(old.updated_at);\nif(!stale&&d&&project==='0be26f75-fc5b-4e15-9d69-efc4cca4e65d'){const current=semantic(d);fingerprint=JSON.stringify(current);context=JSON.stringify(d);last_action=b.action;let changes=[];if(old){const a=semantic(old);for(const k of Object.keys(current))if(JSON.stringify(a[k])!==JSON.stringify(current[k]))changes.push(k==='state'?'state: '+label(d.state):k==='assignees'?'assignees: '+(d.assignees||[]).map(label).join(', '):k+': '+String(current[k]??'none'));}\nnotify=b.action==='create'?previous.last_action!=='create'||previous.fingerprint!==fingerprint:b.action==='delete'?previous.last_action!=='delete':changes.length>0;\nconst action={create:'Created',update:'Updated',delete:'Deleted'}[b.action];const ident='PERSO-'+d.sequence_id;message=action+' **'+ident+' — '+String(d.name||'').replace(/\\n/g,' ')+'**'+(changes.length?'\\n'+changes.join('; '):'')+'\\nhttps://projects.escloud.us/personal/projects/0be26f75-fc5b-4e15-9d69-efc4cca4e65d/issues/'+row.issue_id;\n}\nreturn [{json:{...row,notify,message,fingerprint,context,last_action}}];",
        "mode": "runOnceForAllItems"
      }
    },
