def stop_handler(signum, frame):
    global STOP
    STOP=True


signal.signal(signal.SIGTERM, stop_handler)
signal.signal(signal.SIGINT, stop_handler)


def iso_now():
    return datetime.now(
        timezone.utc
    ).isoformat()


def atomic_json_write(path, data, mode=0o644):
    path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    tmp=path.with_name(
        path.name + ".tmp"
    )

    tmp.write_text(
        json.dumps(
            data,
            ensure_ascii=False,
            separators=(",",":"),
        ) + "\n",
        encoding="utf-8",
    )

    os.chmod(tmp, mode)
    os.replace(tmp, path)


def load_json(path, default):
    try:
        return json.loads(
            path.read_text(
                encoding="utf-8"
            )
        )
    except Exception:
        return default


def run_text(argv, timeout=5):
    proc=None

    try:
        proc=subprocess.Popen(
            argv,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        )

        try:
            stdout,stderr=proc.communicate(
                timeout=timeout
            )

        except subprocess.TimeoutExpired:
            try:
                os.killpg(
                    proc.pid,
                    signal.SIGTERM,
                )
            except Exception:
                pass

            try:
                stdout,stderr=proc.communicate(
                    timeout=0.5
                )
            except Exception:
                try:
                    os.killpg(
                        proc.pid,
                        signal.SIGKILL,
                    )
                except Exception:
                    pass

                stdout,stderr=proc.communicate()

            return None

        if proc.returncode != 0:
            return None

        return stdout

    except Exception:
        return None


def probe_tcp(host, port, timeout=2):
    started=time.monotonic()

    try:
        with socket.create_connection(
            (host, int(port)),
            timeout=timeout,
        ):
            pass

        return {
            "ok":True,
            "latency_ms":round(
                (
                    time.monotonic()
                    - started
                ) * 1000
            ),
            "error":None,
        }

    except Exception as exc:
        return {
            "ok":False,
            "latency_ms":round(
                (
                    time.monotonic()
                    - started
                ) * 1000
            ),
            "error":
                (
                    f"{type(exc).__name__}: "
                    f"{exc}"
                )[:180],
        }


def http_get(url, timeout=2):
    parsed=urlsplit(url)

    port=parsed.port
    if port is None:
        port=443 if parsed.scheme == "https" else 80

    path=parsed.path or "/"

    if parsed.query:
        path += "?" + parsed.query

    conn=None
    started=time.monotonic()

    try:
        if parsed.scheme == "https":
            import ssl

            context=ssl._create_unverified_context()

            conn=http.client.HTTPSConnection(
                parsed.hostname,
                port,
                timeout=timeout,
                context=context,
            )

        else:
            conn=http.client.HTTPConnection(
                parsed.hostname,
                port,
                timeout=timeout,
            )

        conn.request(
            "GET",
            path,
            headers={
                "User-Agent":
                    "edge-monitor/1.0",

                "Connection":"close",
            },
        )

        response=conn.getresponse()
        body=response.read(1024 * 1024)

        code=int(response.status)

        ok=(
            200 <= code < 400
            or code in (401,403)
        )

        return {
            "ok":ok,
            "code":code,
            "body":body,
            "latency_ms":round(
                (
                    time.monotonic()
                    - started
                ) * 1000
            ),
            "error":None,
        }

    except Exception as exc:
        return {
            "ok":False,
            "code":None,
            "body":b"",
            "latency_ms":round(
                (
                    time.monotonic()
                    - started
                ) * 1000
            ),
            "error":
                (
                    f"{type(exc).__name__}: "
                    f"{exc}"
                )[:180],
        }

    finally:
        if conn is not None:
            try:
                conn.close()
            except Exception:
                pass


def http_json(url, headers=None, timeout=3):
    parsed=urlsplit(url)

    port=parsed.port
    if port is None:
        port=443 if parsed.scheme == "https" else 80

    path=parsed.path or "/"

    if parsed.query:
        path += "?" + parsed.query

    conn=None

    try:
        if parsed.scheme == "https":
            import ssl

            context=ssl._create_unverified_context()

            conn=http.client.HTTPSConnection(
                parsed.hostname,
                port,
                timeout=timeout,
                context=context,
            )

        else:
            conn=http.client.HTTPConnection(
                parsed.hostname,
                port,
                timeout=timeout,
            )

        h={
            "User-Agent":"edge-monitor/1.0",
            "Connection":"close",
        }

        if headers:
            h.update(headers)

        conn.request(
            "GET",
            path,
            headers=h,
        )

        response=conn.getresponse()
        raw=response.read(
            4 * 1024 * 1024
        )

        if not (
            200 <= int(response.status) < 300
        ):
            return None

        return json.loads(
            raw.decode(
                "utf-8",
                errors="strict",
            )
        )

    except Exception:
        return None

    finally:
        if conn is not None:
            try:
                conn.close()
            except Exception:
                pass


def state_rank(value):
    return {
        "OK":0,
        "DEGRADED":1,
        "FAIL":2,
    }.get(value,2)


def aggregate(states):
    if not states:
        return "OK"

    return max(
        states,
        key=state_rank,
    )


class ProbeTracker:
    def __init__(self, threshold):
        self.threshold=threshold
        self.entries={}

    def observe(
        self,
        key,
        ok,
        detail=None,
    ):
        prev=self.entries.get(
            key,
            {
                "state":None,
                "failures":0,
                "last_success_at":None,
            },
        )

        now=iso_now()

        if ok:
            failures=0
            state="OK"
            last_success=now

        else:
            failures=(
                int(
                    prev.get(
                        "failures",
                        0,
                    )
                )
                + 1
            )

            if failures >= self.threshold:
                state="FAIL"
            else:
                state=prev.get("state")

                if state is None:
                    state="OK"

            last_success=prev.get(
                "last_success_at"
            )

        entry={
            "state":state,
            "failures":failures,
            "last_probe_at":now,
            "last_success_at":last_success,
            "detail":detail,
        }

        self.entries[key]=entry
        return dict(entry)


PREV_CPU_BUSY = None
PREV_CPU_TOTAL = None


def read_cpu_times():
    try:
        lines = (
            Path("/proc/stat")
            .read_text(encoding="utf-8")
            .splitlines()
        )
        for line in lines:
            if line.startswith("cpu "):
                parts = [float(x) for x in line.split()[1:]]
                user, nice, system, idle, iowait, irq, softirq, steal = parts[:8]
                idle_time = idle + iowait
                busy_time = user + nice + system + irq + softirq + steal
                total = idle_time + busy_time
                return busy_time, total
    except Exception:
        pass
    return None, None


def read_cpu_percent():
    global PREV_CPU_BUSY, PREV_CPU_TOTAL
    busy, total = read_cpu_times()
    if busy is None or total is None:
        return None

    pct = None
    if PREV_CPU_BUSY is not None and PREV_CPU_TOTAL is not None:
        delta_total = total - PREV_CPU_TOTAL
        delta_busy = busy - PREV_CPU_BUSY
        if delta_total > 0:
            pct = round(
                max(0.0, min(100.0, (delta_busy / delta_total) * 100.0)),
                1,
            )

    PREV_CPU_BUSY = busy
    PREV_CPU_TOTAL = total
    return pct


def read_memory():
    values={}

    try:
        lines=Path(
            "/proc/meminfo"
        ).read_text(
            encoding="utf-8"
        ).splitlines()

        for line in lines:
            if ":" not in line:
                continue

            key,value=line.split(
                ":",
                1,
            )

            fields=value.strip().split()

            if fields:
                values[key]=int(
                    fields[0]
                ) * 1024

    except Exception:
        return {}

    total=values.get("MemTotal")
    available=values.get(
        "MemAvailable"
    )

    used_percent=None

    if total and available is not None:
        used_percent=round(
            (
                total - available
            ) * 100 / total,
            2,
        )

    return {
        "total_bytes":total,
        "available_bytes":available,
        "used_percent":used_percent,
    }


def collect_fast(config):
    load=[]

    try:
        fields=Path(
            "/proc/loadavg"
        ).read_text(
            encoding="utf-8"
        ).split()

        load=[
            float(fields[0]),
            float(fields[1]),
            float(fields[2]),
        ]
    except Exception:
        pass

    root=shutil.disk_usage("/")
    cores=os.cpu_count() or 2
    cpu_pct=read_cpu_percent()

    return {
        "updated_at":iso_now(),

        "uptime_s":round(
            time.monotonic()
            - START_MONOTONIC,
            1,
        ),

        "cpu":{
            "used_percent":cpu_pct,
            "cores":cores,
        },

        "load":load,

        "memory":read_memory(),

        "root_fs":{
            "total_bytes":root.total,
            "used_bytes":root.used,
            "free_bytes":root.free,
            "used_percent":round(
                root.used
                * 100
                / root.total,
                2,
            ),
        },
    }


def collect_system_units(
    config,
    tracker,
):
    result={}

    for unit in config[
        "system_units"
    ]:
        raw=run_text(
            [
                "systemctl",
                "is-active",
                unit,
            ],
            timeout=3,
        )

        active=(
            isinstance(raw,str)
            and raw.strip() == "active"
        )

        result[unit]=tracker.observe(
            "system:" + unit,
            active,
            {
                "active":
                    active
            },
        )

    return result


