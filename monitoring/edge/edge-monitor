def collect_docker(
    config,
    tracker,
):
    result={}

    for name in config[
        "docker_containers"
    ]:
        raw=run_text(
            [
                "docker",
                "inspect",
                "--format",
                (
                    "{{.State.Status}}|"
                    "{{if .State.Health}}"
                    "{{.State.Health.Status}}"
                    "{{end}}"
                ),
                name,
            ],
            timeout=4,
        )

        status=None
        health=None

        if isinstance(raw,str):
            fields=raw.strip().split(
                "|",
                1,
            )

            status=fields[0]

            if len(fields) > 1:
                health=fields[1] or None

        ok=(
            status == "running"
            and health not in (
                "unhealthy",
                "starting",
            )
        )

        result[name]=tracker.observe(
            "docker:" + name,
            ok,
            {
                "status":status,
                "health":health,
            },
        )

    return result


def collect_http_probes(
    config,
    tracker,
):
    urls=config[
        "http_probes"
    ]

    raw_results={}

    with concurrent.futures.ThreadPoolExecutor(
        max_workers=max(
            1,
            len(urls),
        )
    ) as pool:

        futures={
            pool.submit(
                http_get,
                url,
                2,
            ): key

            for key,url
            in urls.items()
        }

        for future in concurrent.futures.as_completed(
            futures
        ):
            key=futures[future]

            try:
                raw_results[key]=future.result()
            except Exception as exc:
                raw_results[key]={
                    "ok":False,
                    "code":None,
                    "latency_ms":None,
                    "error":
                        (
                            f"{type(exc).__name__}: "
                            f"{exc}"
                        )[:180],
                }

    public={}

    for key in urls:
        r=raw_results[key]

        public[key]=tracker.observe(
            "http:" + key,
            bool(r.get("ok")),
            {
                "code":r.get("code"),
                "latency_ms":
                    r.get("latency_ms"),
                "error":r.get("error"),
            },
        )

    return public


def collect_n8n_workflows(config, now=None):
    """Read only the selected scheduled workflows; manual tests cannot mask failures."""
    settings = config.get("n8n_workflows")
    if not settings:
        return {"state": "OK", "detail": {"workflows": [], "reasons": []}}
    now = time.time() if now is None else now
    results, reasons = [], []
    try:
        with sqlite3.connect(
            Path(settings["database"]).as_uri() + "?mode=ro", uri=True, timeout=2
        ) as db:
            db.execute("PRAGMA query_only=ON")
            for spec in settings["workflows"]:
                wid = spec["id"]
                row = db.execute(
                    "SELECT name, active, nodes, settings, createdAt FROM workflow_entity WHERE id=?",
                    (wid,),
                ).fetchone()
                if row is None:
                    reasons.append(wid + ": workflow missing")
                    continue
                name, active, nodes, workflow_settings, created = row
                schedules = [
                    node for node in json.loads(nodes)
                    if node["type"] == "n8n-nodes-base.scheduleTrigger" and not node.get("disabled")
                ]
                cadence = None
                if len(schedules) == 1:
                    intervals = schedules[0]["parameters"]["rule"]["interval"]
                    if len(intervals) == 1:
                        rule = intervals[0]
                        field = rule.get("field", "days")
                        scale = {"seconds": 1, "minutes": 60, "hours": 3600}.get(field)
                        if scale:
                            cadence = scale * int(rule.get(field + "Interval", 1))
                contract_ok = bool(active) and cadence == spec["cadence_s"]
                if not contract_ok:
                    reasons.append(wid + ": active schedule differs from monitored contract")
                cadence = spec["cadence_s"]
                success = db.execute(
                    "SELECT startedAt FROM execution_entity WHERE workflowId=? AND mode='trigger' "
                    "AND status='success' ORDER BY startedAt DESC LIMIT 1", (wid,),
                ).fetchone()
                completed = db.execute(
                    "SELECT status FROM execution_entity WHERE workflowId=? AND mode='trigger' "
                    "AND status NOT IN ('new','running','waiting') ORDER BY startedAt DESC LIMIT ?",
                    (wid, settings["consecutive_failure_threshold"]),
                ).fetchall()
                failures = 0
                for (status,) in completed:
                    if status not in ("error", "crashed", "canceled"):
                        break
                    failures += 1
                timestamp = success[0] if success else created
                parsed = datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
                if parsed.tzinfo is None:
                    parsed = parsed.replace(tzinfo=timezone.utc)
                age = max(0, now - parsed.timestamp())
                timeout = int(json.loads(workflow_settings or "{}").get("executionTimeout", 0))
                stale_after = cadence * settings["stale_cadence_multiplier"] + max(0, timeout)
                state = "OK" if contract_ok else "DEGRADED"
                if failures >= settings["consecutive_failure_threshold"]:
                    reasons.append(f"{wid}: {failures} consecutive scheduled failures")
                    state = "DEGRADED"
                if age > stale_after:
                    reasons.append(f"{wid}: {'no success' if not success else 'last success stale'} "
                                   f"({round(age)}s > {stale_after}s)")
                    state = "DEGRADED"
                results.append({"id": wid, "name": name, "state": state, "cadence_s": cadence,
                                "last_success": success[0] if success else None,
                                "success_age_s": round(age), "stale_after_s": stale_after,
                                "consecutive_failures": failures})
        return {"state": "DEGRADED" if reasons else "OK",
                "detail": {"workflows": results, "reasons": reasons}}
    except (sqlite3.Error, OSError, ValueError, KeyError, TypeError) as exc:
        return {"state": "FAIL", "detail": {"workflows": results,
                "reasons": ["Execution-state read failed: " + str(exc)[:180]]}}


def collect_cross_site(
    config,
    tracker,
):
    pve=config["pve"]
    ai=config["ai_node"]

    pve_raw=probe_tcp(
        pve["host"],
        pve["port"],
        timeout=2,
    )

    ai_raw=probe_tcp(
        ai["host"],
        ai["port"],
        timeout=2,
    )

    result={
        "pve":
            tracker.observe(
                "cross-site:pve",
                pve_raw["ok"],
                pve_raw,
            ),

        "ai_node":
            tracker.observe(
                "cross-site:ai-node",
                ai_raw["ok"],
                ai_raw,
            ),
    }

    vllm_detail={
        "mode":"unknown",
        "model":None,
    }

    if ai_raw["ok"]:
        sleeping=False
        sleep_known=False

        sleep_response=http_get(
            ai["base_url"]
            + "/is_sleeping",
            timeout=2,
        )

        if sleep_response.get("ok"):
            text=(
                sleep_response.get(
                    "body",
                    b"",
                )
                .decode(
                    "utf-8",
                    errors="ignore",
                )
                .strip()
                .lower()
            )

            if text in (
                "true",
                "1",
                '"true"',
            ):
                sleeping=True
                sleep_known=True

            elif text in (
                "false",
                "0",
                '"false"',
            ):
                sleep_known=True

            else:
                try:
                    value=json.loads(text)

                    if isinstance(value,bool):
                        sleeping=value
                        sleep_known=True

                    elif isinstance(value,dict):
                        for key in (
                            "is_sleeping",
                            "sleeping",
                        ):
                            if isinstance(
                                value.get(key),
                                bool,
                            ):
                                sleeping=value[key]
                                sleep_known=True
                                break
                except Exception:
                    pass

        if sleeping:
            vllm_ok=True
            vllm_detail["mode"]="sleeping"

        else:
            models=http_json(
                ai["base_url"]
                + "/v1/models",
                timeout=3,
            )

            ids=[]

            if isinstance(models,dict):
                for item in (
                    models.get("data")
                    or []
                ):
                    if isinstance(item,dict):
                        model_id=item.get("id")

                        if isinstance(
                            model_id,
                            str,
                        ):
                            ids.append(
                                model_id
                            )

            vllm_ok=(
                ai["expected_model"]
                in ids
            )

            vllm_detail["mode"]=(
                "awake"
                if sleep_known
                else "available"
            )

            if ids:
                vllm_detail["model"]=ids[0]

    else:
        vllm_ok=False

    result["vllm"]=tracker.observe(
        "cross-site:vllm",
        vllm_ok,
        vllm_detail,
    )

    return result


def syncthing_api_key(config):
    for raw in config[
        "syncthing"
    ][
        "config_candidates"
    ]:
        p=Path(raw)

        if not p.is_file():
            continue

        try:
            root=ET.parse(p).getroot()

            key=root.findtext(
                "./gui/apikey"
            )

            if key:
                return key.strip()

        except Exception:
            continue

    return None


def collect_syncthing(
    config,
    tracker,
):
    st=config["syncthing"]
    key=syncthing_api_key(
        config
    )

    if not key:
        entry=tracker.observe(
            "syncthing:api",
            False,
            {
                "error":
                    "api key unavailable"
            },
        )

        return {
            "state":entry["state"],
            "api":entry,
        }

    headers={
        "X-API-Key":key,
    }

    connections=http_json(
        st["base_url"]
        + "/rest/system/connections",
        headers=headers,
        timeout=3,
    )

    folder=http_json(
        st["base_url"]
        + "/rest/db/status?folder="
        + st["folder_id"],
        headers=headers,
        timeout=3,
    )

    api_ok=(
        isinstance(connections,dict)
        and isinstance(folder,dict)
    )

    api_state=tracker.observe(
        "syncthing:api",
        api_ok,
        {
            "error":
                None
                if api_ok
                else "REST API unavailable",
        },
    )

    remote_connected=None

    if isinstance(connections,dict):
        rows=(
            connections.get(
                "connections"
            )
            or {}
        )

        if isinstance(rows,dict):
            remote_connected=any(
                isinstance(value,dict)
                and value.get(
                    "connected"
                ) is True

                for value
                in rows.values()
            )

    peer_state=tracker.observe(
        "syncthing:pve-peer",
        remote_connected is True,
        {
            "connected":
                remote_connected
        },
    )

    pull_errors=None
    need_files=None
    need_bytes=None
    folder_state=None

    if isinstance(folder,dict):
        folder_state=folder.get(
            "state"
        )

        pull_errors=folder.get(
            "pullErrors"
        )

        need_files=folder.get(
            "needFiles"
        )

        need_bytes=folder.get(
            "needBytes"
        )

    error_free=(
        pull_errors in (
            None,
            0,
            [],
            {},
        )
    )

    folder_health=tracker.observe(
        "syncthing:folder",
        bool(
            isinstance(folder,dict)
            and error_free
        ),
        {
            "state":folder_state,
            "pull_errors":pull_errors,
            "need_files":need_files,
            "need_bytes":need_bytes,
        },
    )

    return {
        "state":
            aggregate([
                api_state["state"],
                peer_state["state"],
                folder_health["state"],
            ]),

        "api":api_state,
        "pve_peer":peer_state,
        "folder":folder_health,
    }


def collect_netbird(tracker):
    raw=run_text(
        [
            "netbird",
            "status",
        ],
        timeout=5,
    )

    management=None
    signal=None

    if isinstance(raw,str):
        lower=raw.lower()

        management=(
            "management: connected"
            in lower
            or "management connected"
            in lower
        )

        signal=(
            "signal: connected"
            in lower
            or "signal connected"
            in lower
        )

    ok=(
        isinstance(raw,str)
        and management is not False
        and signal is not False
    )

    return tracker.observe(
        "netbird:control",
        ok,
        {
            "management_connected":
                management,

            "signal_connected":
                signal,
        },
    )


def collect_backrest(config):
    result={}

    p=Path(
        config[
            "backrest"
        ][
            "oplog"
        ]
    )

    now_ms=int(
        time.time() * 1000
    )

    for plan in config[
        "backrest"
    ][
        "plans"
    ]:
        item={
            "state":"FAIL",
            "last_success_at":None,
            "age_s":None,
            "snapshot_id":None,
            "error":None,
        }

        try:
            con=sqlite3.connect(
                f"file:{p}?mode=ro",
                uri=True,
                timeout=2,
            )

            try:
                row=con.execute(
                    """
                    SELECT
                        o.start_time_ms,
                        o.snapshot_id
                    FROM operations o
                    JOIN operation_groups g
                      ON g.ogid = o.ogid
                    WHERE g.plan_id = ?
                      AND o.status = 3
                      AND o.snapshot_id <> ''
                    ORDER BY
                        o.start_time_ms DESC,
                        o.id DESC
                    LIMIT 1
                    """,
                    (plan,),
                ).fetchone()

            finally:
                con.close()

            if row is None:
                item["error"] = (
                    "no successful snapshot"
                )

            else:
                ts_ms=int(row[0])
                age_s=max(
                    0,
                    round(
                        (
                            now_ms
                            - ts_ms
                        ) / 1000,
                        1,
                    ),
                )

                dt=datetime.fromtimestamp(
                    ts_ms / 1000,
                    tz=timezone.utc,
                )

                item[
                    "last_success_at"
                ]=dt.isoformat()

                item["age_s"]=age_s
                item["snapshot_id"]=row[1]

                if (
                    age_s
                    <= config[
                        "backrest"
                    ][
                        "degraded_after_s"
                    ]
                ):
                    item["state"]="OK"

                elif (
                    age_s
                    <= config[
                        "backrest"
                    ][
                        "fail_after_s"
                    ]
                ):
                    item[
                        "state"
                    ]="DEGRADED"

                else:
                    item["state"]="FAIL"

        except Exception as exc:
            item["error"]=(
                f"{type(exc).__name__}: "
                f"{exc}"
            )[:180]

        result[plan]=item

    return {
        "state":
            aggregate([
                x["state"]
                for x in result.values()
            ]),

        "plans":result,
    }


def find_key_recursive(obj, wanted):
    if isinstance(obj,dict):
        for key,value in obj.items():
            if str(key).upper() == wanted:
                return value

        for value in obj.values():
            found=find_key_recursive(
                value,
                wanted,
            )

            if found is not None:
                return found

    elif isinstance(obj,list):
        for value in obj:
            found=find_key_recursive(
                value,
                wanted,
            )

            if found is not None:
                return found

    return None


def as_int(value):
    try:
        return int(value)
    except Exception:
        return 0


def collect_maintenance(config):
    data=None
    source=None

    for raw in config[
        "maintenance"
    ][
        "status_candidates"
    ]:
        p=Path(raw)

        if not p.is_file():
            continue

        try:
            data=json.loads(
                p.read_text(
                    encoding="utf-8"
                )
            )
            source=str(p)
            break
        except Exception:
            continue

    if data is None:
        return {
            "state":"DEGRADED",
            "source":None,
            "check_failed":None,
            "reboot_required":None,
            "update_available":None,
            "generated_at":None,
            "error":
                "maintenance status unavailable",
        }

    check_failed=as_int(
        find_key_recursive(
            data,
            "CHECK_FAILED",
        )
    )

    reboot_required=as_int(
        find_key_recursive(
            data,
            "REBOOT_REQUIRED",
        )
    )

    update_available=as_int(
        find_key_recursive(
            data,
            "UPDATE_AVAILABLE",
        )
    )

    generated_at=(
        find_key_recursive(
            data,
            "GENERATED_AT",
        )
        or find_key_recursive(
            data,
            "GENERATED",
        )
    )

    state=(
        "DEGRADED"
        if (
            check_failed > 0
            or reboot_required > 0
        )
        else "OK"
    )

    return {
        "state":state,
        "source":source,
        "check_failed":check_failed,
        "reboot_required":reboot_required,
        "update_available":update_available,
        "generated_at":generated_at,
        "error":None,
    }


