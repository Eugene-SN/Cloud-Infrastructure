        ("edge-state", "Edge state backup"),
        ("edge-knowledge-local", "Edge Knowledge backup"),
    ):
        plan = (backrest.get("plans") or {}).get(plan_id) or {}
        state = _item_state(plan)
        age = plan.get("age_s")
        last_success = plan.get("last_success_at")
        error = plan.get("error")
        if error:
            cause = str(error)
        elif age is not None:
            cause = f"Last successful snapshot is {_human_duration(age)} old"
        else:
            cause = "No successful snapshot freshness data"
        diagnostics = [
            f"Plan: {plan_id}",
            f"Last success: {_fmt_time(last_success)}",
            f"Age: {_human_duration(age)}",
        ]
        if error:
            diagnostics.append(f"Error: {error}")
        incidents["backup-" + plan_id] = _make_incident(
            "backup-" + plan_id,
            state,
            label,
            "OPERATIONS",
            "Backup freshness",
            f"Backup plan {plan_id} is outside its accepted freshness state.",
            cause,
            diagnostics,
            suppressed=bool(backrest_runtime_state != "OK" and state != "OK"),
        )

    maintenance = operations.get("maintenance") or {}
    maintenance_state = _item_state(maintenance)
    check_failed = maintenance.get("check_failed")
    reboot_required = maintenance.get("reboot_required")
    reasons = []
    if check_failed:
        reasons.append(f"maintenance checks failed: {check_failed}")
    if reboot_required:
        reasons.append(f"reboot required: {reboot_required}")
    incidents["maintenance-health"] = _make_incident(
        "maintenance-health",
        maintenance_state,
        "Maintenance health",
        "OPERATIONS",
        "Maintenance state",
        "Maintenance requires operator attention.",
        "; ".join(reasons) if reasons else "Maintenance semantic state is healthy",
        [
            f"CHECK_FAILED={check_failed}",
            f"REBOOT_REQUIRED={reboot_required}",
            f"UPDATE_AVAILABLE={maintenance.get('update_available')}",
            f"Generated: {_fmt_time(maintenance.get('generated_at'))}",
        ],
    )

    return incidents


def _event_visual(state, recovery=False):
    if recovery:
        return "✅", "good", "RECOVERED"
    if state == "FAIL":
        return "🔴", "danger", "INCIDENT"
    return "⚠️", "warning", "DEGRADED"


def _event_title(incident, recovery=False):
    name = incident.get("name") or incident.get("id") or "Service"
    if recovery:
        return f"{name} recovered"
    if incident.get("state") == "FAIL":
        return f"{name} unavailable"
    return f"{name} degraded"


def _text_block(text, subtle=False, size=None):
    block = {"type": "text", "text": str(text)}
    if subtle:
        block["is_subtle"] = True
    if size:
        block["size"] = size
    return block


def _metric_column(label, value):
    return {
        "type": "column",
        "width": "stretch",
        "items": [
            _text_block(f"**{label}**", subtle=True, size="small"),
            _text_block(str(value)),
        ],
    }


def render_event_payload(
    incident,
    recovery=False,
    started_at=None,
    ended_at=None,
    previous_state=None,
):
    icon, accent, event_class = _event_visual(
        incident.get("state"),
        recovery=recovery,
    )
    title = _event_title(incident, recovery=recovery)
    scope = incident.get("scope") or "EDGE"
    category = incident.get("category") or "Service"
    impact = incident.get("impact") or "Operational state changed."
    if recovery:
        impact = f"{incident.get('name') or incident.get('id') or 'Service'} is responding normally again."
    diagnostics = list(incident.get("diagnostics") or [])

    if recovery:
        duration = _human_duration(_duration_s(started_at, ended_at))
        fallback = (
            f"{icon} **{title}**\n"
            f"{scope} · {category}\n"
            f"{impact}\n"
            f"Downtime/degradation: {duration}\n"
            f"Recovered: {_fmt_time(ended_at or iso_now())}"
        )
        body = [
            _text_block(f"### {icon} {title}"),
            _text_block(f"{scope} · {category}", subtle=True, size="small"),
            _text_block(impact),
            {"type": "divider"},
            _text_block("DURATION", subtle=True, size="small"),
            _text_block(duration),
            _text_block("RECOVERED", subtle=True, size="small"),
            _text_block(_fmt_time(ended_at or iso_now())),
        ]
    else:
        confirmation = incident.get("confirmation")
        fallback = (
            f"{icon} **{title}**\n"
            f"{scope} · {category}\n"
            f"{impact}\n"
            f"Cause: {incident.get('cause') or 'unknown'}\n"
            f"Started: {_fmt_time(started_at or iso_now())}"
        )
        body = [
            _text_block(f"### {icon} {title}"),
            _text_block(f"{scope} · {category}", subtle=True, size="small"),
            _text_block(impact),
            {"type": "divider"},
            _text_block("CAUSE", subtle=True, size="small"),
            _text_block(incident.get("cause") or "Unknown cause"),
            {"type": "divider"},
            _text_block("STARTED", subtle=True, size="small"),
            _text_block(_fmt_time(started_at or iso_now())),
        ]
        if confirmation:
            body.extend(
                [
                    _text_block("CONFIRMED", subtle=True, size="small"),
                    _text_block(confirmation),
                ]
            )

    if diagnostics:
        diag_text = "\n".join(f"- {line}" for line in diagnostics[:12])
        body.append(
            {
                "type": "collapsible",
                "collapsed": True,
                "header": [_text_block("**Diagnostics**")],
                "content": [_text_block(diag_text, subtle=True, size="small")],
            }
        )

    payload = {
        "props": {
            "mm_blocks": [
                {
                    "type": "container",
                    "content": body,
                    "border": True,
                    "accent_color": accent,
                    "background": "gray",
                    "flow": "vertical",
                    "gap": "small",
                }
            ]
        },
    }
    return payload


def post_mattermost(payload):
    url = webhook_url()
    parsed = urlsplit(url)
    conn = None

    if isinstance(payload, str):
        payload = {"text": payload}

    body_bytes = json.dumps(
        payload,
        ensure_ascii=False,
    ).encode("utf-8")

    try:
        conn = http.client.HTTPConnection(
            parsed.hostname,
            parsed.port or 80,
            timeout=3,
        )
        conn.request(
            "POST",
            parsed.path,
            body=body_bytes,
            headers={
                "Content-Type": "application/json",
                "Content-Length": str(len(body_bytes)),
                "Connection": "close",
            },
        )
        response = conn.getresponse()
        response_body = response.read(4096)
        return response.status == 200 and response_body.strip() == b"ok"
    except Exception:
        return False
    finally:
        if conn is not None:
            try:
                conn.close()
            except Exception:
                pass


def update_notifications(incidents, durable):
    now = iso_now()
    changed = False

    legacy = durable.pop("notified", None)
    if legacy is not None:
        changed = True

    records = durable.setdefault("incidents", {})
    if not isinstance(records, dict):
        records = {}
        durable["incidents"] = records
        changed = True

    current_ids = set(incidents)
    for stale_id in list(records):
        if stale_id not in current_ids:
            del records[stale_id]
            changed = True

    first_v2_run = durable.get("notification_model") != 2

    for incident_id, current in incidents.items():
        state = current.get("state")
        if state not in ("OK", "DEGRADED", "FAIL"):
            continue

        suppressed = bool(current.get("suppressed"))
        previous = records.get(incident_id)

        if not isinstance(previous, dict):
            records[incident_id] = {
                "state": state,
                "started_at": now if state != "OK" else None,
                "notified_active": False,
                "suppressed": suppressed,
            }
            changed = True
            continue

        previous_state = previous.get("state", "OK")
        started_at = previous.get("started_at")
        notified_active = bool(previous.get("notified_active"))

        if state == "OK":
            if previous_state != "OK" and notified_active:
                payload = render_event_payload(
                    current,
                    recovery=True,
                    started_at=started_at,
                    ended_at=now,
                    previous_state=previous_state,
                )
                if not post_mattermost(payload):
                    continue

            if (
                previous_state != "OK"
                or started_at is not None
                or notified_active
                or previous.get("suppressed") != suppressed
            ):
                records[incident_id] = {
                    "state": "OK",
                    "started_at": None,
                    "notified_active": False,
                    "suppressed": suppressed,
                }
                changed = True
            continue

        if previous_state == "OK":
            started_at = now

        should_notify = False
        if not suppressed:
            if previous_state == "OK":
                should_notify = True
            elif not notified_active:
                should_notify = True
            elif previous_state != state:
                should_notify = True

        if should_notify and not first_v2_run:
            payload = render_event_payload(
                current,
                recovery=False,
                started_at=started_at,
                previous_state=previous_state,
            )
            if not post_mattermost(payload):
                continue
            notified_active = True

        records[incident_id] = {
            "state": state,
            "started_at": started_at,
            "notified_active": notified_active,
            "suppressed": suppressed,
        }
        changed = True

    if first_v2_run:
        durable["notification_model"] = 2
        changed = True

    if changed:
        durable["updated_at"] = now
        save_notification_state(durable)


def check_summary(snapshot):
    return build_incidents(snapshot)



def main():
    config=load_json(
        CONFIG_PATH,
        None,
    )

    if not isinstance(config,dict):
        raise RuntimeError(
            "invalid configuration"
        )

    intervals=config[
        "intervals_s"
    ]

    tracker=ProbeTracker(
        int(
            config.get(
                "fail_threshold",
                2,
            )
        )
    )

    RUN_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    STATE_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    durable=load_notification_state()

    caches={
        "fast":{},
        "system_units":{},
        "user_units":{},
        "docker":{},
        "applications":{},
        "home_pai":{},
        "netbird":{},
        "syncthing":{},
        "backrest":{},
        "maintenance":{},
    }

    executor=(
        concurrent.futures
        .ThreadPoolExecutor(
            max_workers=3,
            thread_name_prefix=
                "edge-monitor",
        )
    )

    normal_future=None
    slow_future=None
    operations_future=None

    sequence=0

    next_fast=0.0
    next_normal=0.0
    next_slow=0.0
    next_operations=0.0
    next_snapshot=0.0

    read_cpu_percent()
    time.sleep(0.08)

    def normal_bundle():
        return {
            "system_units":
                collect_system_units(
                    config,
                    tracker,
                ),

            "user_units":
                collect_user_units(
                    config,
                    tracker,
                ),

            "docker":
                collect_docker(
                    config,
                    tracker,
                ),

            "applications":
                {**collect_http_probes(
                    config,
                    tracker,
                ), "n8n_workflows": collect_n8n_workflows(config)},

            "home_pai":
                collect_cross_site(
                    config,
                    tracker,
                ),
        }

    def slow_bundle():
        return {
            "netbird":
                collect_netbird(
                    tracker
                ),

            "syncthing":
                collect_syncthing(
                    config,
                    tracker,
                ),
        }

    def operations_bundle():
        return {
            "backrest":
                collect_backrest(
                    config
                ),

            "maintenance":
                collect_maintenance(
                    config
                ),
        }

    try:
        while not STOP:
            now=time.monotonic()

            if (
                normal_future is not None
                and normal_future.done()
            ):
                try:
                    caches.update(
                        normal_future.result()
                    )
                except Exception as exc:
                    print(
                        "NORMAL_COLLECT_ERROR="
                        f"{type(exc).__name__}:"
                        f"{exc}",
                        flush=True,
                    )

                normal_future=None

            if (
                slow_future is not None
                and slow_future.done()
            ):
                try:
                    caches.update(
                        slow_future.result()
                    )
                except Exception as exc:
                    print(
                        "SLOW_COLLECT_ERROR="
                        f"{type(exc).__name__}:"
                        f"{exc}",
                        flush=True,
                    )

                slow_future=None

            if (
                operations_future is not None
                and operations_future.done()
            ):
                try:
                    caches.update(
                        operations_future.result()
                    )
                except Exception as exc:
                    print(
                        "OPERATIONS_COLLECT_ERROR="
                        f"{type(exc).__name__}:"
                        f"{exc}",
                        flush=True,
                    )

                operations_future=None

            if now >= next_fast:
                caches["fast"]=(
                    collect_fast(
                        config
                    )
                )

                next_fast=(
                    time.monotonic()
                    + intervals["fast"]
                )

            now=time.monotonic()

            if (
                now >= next_normal
                and normal_future is None
            ):
                normal_future=executor.submit(
                    normal_bundle
                )

                next_normal=(
                    now
                    + intervals["normal"]
                )

            now=time.monotonic()

            if (
                now >= next_slow
                and slow_future is None
            ):
                slow_future=executor.submit(
                    slow_bundle
                )

                next_slow=(
                    now
                    + intervals["slow"]
                )

            now=time.monotonic()

            if (
                now >= next_operations
                and operations_future is None
            ):
                operations_future=executor.submit(
                    operations_bundle
                )

                next_operations=(
                    now
                    + intervals[
                        "operations"
                    ]
                )

            now=time.monotonic()

            if now >= next_snapshot:
                sequence += 1

                system_states=[
                    x["state"]
                    for x in (
                        caches[
                            "system_units"
                        ]
                    ).values()
                ]

                user_states=[
                    x["state"]
                    for x in (
                        caches[
                            "user_units"
                        ]
                    ).values()
                ]

                docker_states=[
                    x["state"]
                    for x in (
                        caches[
                            "docker"
                        ]
                    ).values()
                ]

                app_states=[
                    x["state"]
                    for x in (
                        caches[
                            "applications"
                        ]
                    ).values()
                ]

                home_states=[
                    x["state"]
                    for x in (
                        caches[
                            "home_pai"
                        ]
                    ).values()
                ]

                knowledge_state=(
                    caches[
                        "syncthing"
                    ].get(
                        "state",
                        "OK",
                    )
                    if caches[
                        "syncthing"
                    ]
                    else "OK"
                )

                backrest_state=(
                    caches[
                        "backrest"
                    ].get(
                        "state",
                        "OK",
                    )
                    if caches[
                        "backrest"
                    ]
                    else "OK"
                )

                maintenance_state=(
                    caches[
                        "maintenance"
                    ].get(
                        "state",
                        "OK",
                    )
                    if caches[
                        "maintenance"
                    ]
                    else "OK"
                )

                snapshot={
                    "schema_version":1,
                    "sequence":sequence,
                    "generated_at":iso_now(),

                    "agent":{
                        "name":"edge-monitor",
                        "version":"1.0",
                        "uptime_s":round(
                            time.monotonic()
                            - START_MONOTONIC,
                            1,
                        ),
                    },

                    "intervals_s":
                        intervals,

                    "edge":{
                        "state":
                            aggregate(
                                system_states
                                + user_states
                                + docker_states
                            ),

                        "host":
                            caches["fast"],

                        "system_units":
                            caches[
                                "system_units"
                            ],

                        "core_user_units":
                            caches[
                                "user_units"
                            ],

                        "docker":
                            caches["docker"],
                    },

                    "applications":{
                        **caches[
                            "applications"
                        ]
                    },

                    "home_pai":{
                        "state":
                            aggregate(
                                home_states
                                + (
                                    [
                                        caches[
                                            "netbird"
                                        ][
                                            "state"
                                        ]
                                    ]
                                    if caches[
                                        "netbird"
                                    ]
                                    else []
                                )
                            ),

                        **caches[
                            "home_pai"
                        ],

                        "netbird":
                            caches[
                                "netbird"
                            ],
                    },

                    "knowledge":{
                        "state":
                            knowledge_state,

                        "syncthing":
                            caches[
                                "syncthing"
                            ],
                    },

                    "operations":{
                        "state":
                            aggregate([
                                backrest_state,
                                maintenance_state,
                            ]),

                        "backrest":
                            caches[
                                "backrest"
                            ],

                        "maintenance":
                            caches[
                                "maintenance"
                            ],
                    },
                }

                domain_states=[
                    snapshot[
                        "edge"
                    ][
                        "state"
                    ],

                    aggregate(
                        app_states
                    ),

                    snapshot[
                        "home_pai"
                    ][
                        "state"
                    ],

                    snapshot[
                        "knowledge"
                    ][
                        "state"
                    ],

                    snapshot[
                        "operations"
                    ][
                        "state"
                    ],
                ]

                snapshot[
                    "overall_state"
                ]=aggregate(
                    domain_states
                )

                atomic_json_write(
                    SNAPSHOT_PATH,
                    snapshot,
                )

                checks=check_summary(
                    snapshot
                )

                update_notifications(
                    checks,
                    durable,
                )

                next_snapshot=(
                    now
                    + intervals["fast"]
                )

            time.sleep(0.10)

    finally:
        executor.shutdown(
            wait=True,
            cancel_futures=True,
        )


if __name__ == "__main__":
    main()
