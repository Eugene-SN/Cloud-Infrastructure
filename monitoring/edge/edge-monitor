def _state_rank(value):
    return {"OK": 0, "DEGRADED": 1, "FAIL": 2}.get(value, 2)


def _worst_state(*values):
    states = [value for value in values if value in ("OK", "DEGRADED", "FAIL")]
    if not states:
        return "OK"
    return max(states, key=_state_rank)


def _item_state(item):
    if isinstance(item, dict):
        value = item.get("state")
        if value in ("OK", "DEGRADED", "FAIL"):
            return value
    return "OK"


def _detail(item):
    if isinstance(item, dict):
        value = item.get("detail")
        if isinstance(value, dict):
            return value
    return {}


def _fmt_time(value):
    if not value:
        return "unknown"
    try:
        dt = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt.astimezone().strftime("%d %b %H:%M:%S %Z")
    except Exception:
        return str(value)


def _duration_s(started_at, ended_at=None):
    if not started_at:
        return None
    try:
        start = datetime.fromisoformat(str(started_at).replace("Z", "+00:00"))
        if start.tzinfo is None:
            start = start.replace(tzinfo=timezone.utc)
        if ended_at:
            end = datetime.fromisoformat(str(ended_at).replace("Z", "+00:00"))
            if end.tzinfo is None:
                end = end.replace(tzinfo=timezone.utc)
        else:
            end = datetime.now(timezone.utc)
        return max(0, int((end - start).total_seconds()))
    except Exception:
        return None


def _human_duration(seconds):
    if seconds is None:
        return "unknown"
    seconds = max(0, int(seconds))
    days, rem = divmod(seconds, 86400)
    hours, rem = divmod(rem, 3600)
    minutes, secs = divmod(rem, 60)
    parts = []
    if days:
        parts.append(f"{days}d")
    if hours:
        parts.append(f"{hours}h")
    if minutes:
        parts.append(f"{minutes}m")
    if secs or not parts:
        parts.append(f"{secs}s")
    return " ".join(parts[:2])


def _http_cause(name, item):
    detail = _detail(item)
    error = detail.get("error")
    code = detail.get("code")
    if error:
        return f"{name} probe failed: {error}"
    if code is not None:
        return f"{name} probe returned HTTP {code}"
    return f"{name} health probe failed"


def _http_evidence(name, item):
    detail = _detail(item)
    code = detail.get("code")
    latency = detail.get("latency_ms")
    error = detail.get("error")
    bits = []
    if code is not None:
        bits.append(f"HTTP {code}")
    if latency is not None:
        bits.append(f"{latency} ms")
    if error:
        bits.append(str(error))
    if not bits:
        bits.append(_item_state(item))
    return f"{name}: " + " · ".join(bits)


def _unit_evidence(name, item):
    detail = _detail(item)
    active = detail.get("active")
    if active is True:
        status = "active"
    elif active is False:
        status = "inactive"
    else:
        status = _item_state(item)
    return f"{name}: {status}"


def _container_evidence(name, item):
    detail = _detail(item)
    status = detail.get("status")
    health = detail.get("health")
    bits = []
    if status is not None:
        bits.append(str(status))
    if health is not None:
        bits.append(str(health))
    if not bits:
        bits.append(_item_state(item))
    return f"{name}: " + " · ".join(bits)


def _make_incident(
    incident_id,
    state,
    name,
    scope,
    category,
    impact,
    cause,
    diagnostics=None,
    confirmation=None,
    suppressed=False,
):
    return {
        "id": incident_id,
        "state": state,
        "name": name,
        "scope": scope,
        "category": category,
        "impact": impact,
        "cause": cause,
        "diagnostics": [x for x in (diagnostics or []) if x],
        "confirmation": confirmation,
        "suppressed": bool(suppressed),
    }


